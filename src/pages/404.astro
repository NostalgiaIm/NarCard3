<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 — Example Journal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Grenze:ital,wght@0,100..900;1,100..900&family=Quicksand:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.1.0/style.css" rel="stylesheet">
<style>
:root {
  --bg: #0D0B1A;
  --bg-panel: #1A1728;
  --bg-code: #12101C;
  --bg-glass: rgba(26, 23, 40, 0.72);
  --text: #E8E4F0;
  --text-dim: #9B94A8;
  --text-faint: #5A5470;
  --text-nav: #B8B2C8;
  --text-footer-link: #9B94A8;
  --hero-meta: #8B7AB8;
  --accent: #8B1A4A;
  --accent-bright: #B02A5A;
  --accent-gold: #C9A96E;
  --accent-purple: #4A3F6B;
  --border: rgba(74, 63, 107, 0.35);
  --border-soft: rgba(74, 63, 107, 0.15);
  --top-bar-bg: rgba(13, 11, 26, 0.92);

  --font-gothic: 'UnifrakturMaguntia', serif;
  --font-sharp: 'Cinzel', serif;
  --font-soft: 'Quicksand', sans-serif;
  --font-serif: 'Cormorant Garamond', serif;
  --font-body: 'Grenze', 'LXGW WenKai', 'Noto Serif SC', serif;
  --font-mono: 'JetBrains Mono', monospace;

  --ease-slow: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-soft: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  --candle-h: 140px;
  --orb-radius: 90px;
  --orb-icon-size: 56px;
  --orb-btn-size: 42px;
}

body[data-theme="bloodmoon"] {
  --bg: #1A0A0A;
  --bg-panel: #2A1212;
  --bg-code: #1A0808;
  --bg-glass: rgba(42, 18, 18, 0.72);
  --text: #F0E0E0;
  --text-dim: #B88A8A;
  --text-faint: #6B4040;
  --text-nav: #D0A8A8;
  --text-footer-link: #B88A8A;
  --hero-meta: #C97A7A;
  --accent: #C42A2A;
  --accent-bright: #E03A3A;
  --accent-gold: #E8A040;
  --accent-purple: #6B2A2A;
  --border: rgba(140, 60, 60, 0.4);
  --border-soft: rgba(140, 60, 60, 0.2);
  --top-bar-bg: rgba(26, 10, 10, 0.92);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
button,
a,
.not-found-code,
.not-found-text,
.not-found-subtext,
.not-found-button,
.not-found-ornament,
.not-found-bottom,
.logo,
.section-indicator,
.side-orb,
.side-orb *,
.theme-toggle,
#back-to-top {
  -webkit-user-select: none;
  -moz-user-select: none;
  user-select: none;
  -webkit-user-drag: none;
}
img,
svg {
  -webkit-user-select: none;
  user-select: none;
  -webkit-user-drag: none;
}
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 19px;
  line-height: 1.95;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
  transition: background 1.2s ease, color 1.2s ease;
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.035;
  pointer-events: none;
  z-index: 9998;
}

#particles-canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
#cursor-trail { position: fixed; inset: 0; z-index: 9997; pointer-events: none; }

#scroll-progress {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent-purple), var(--accent), var(--accent-gold));
  width: 0%;
  z-index: 10000;
  transition: width 0.1s linear;
  box-shadow: 0 0 12px rgba(201, 169, 110, 0.5);
}

/* ============== 顶部栏 ============== */
.top-bar {
  position: sticky; top: 0; z-index: 100;
  background: var(--top-bar-bg);
  transition: background 1.2s ease;
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px 24px;
}

.ornament-line {
  position: relative;
  flex: 1;
  height: 26px;
  min-width: 40px;
}

.ornament-line::before {
  content: '';
  position: absolute;
  top: 50%; left: 0; right: 0;
  height: 1px;
  transform: translateY(-50%);
  z-index: 1;
}

.ornament-line-left::before {
  background: linear-gradient(to right,
    rgba(201, 169, 110, 0) 0%,
    rgba(201, 169, 110, 0.08) 20%,
    rgba(201, 169, 110, 0.22) 45%,
    rgba(201, 169, 110, 0.45) 70%,
    rgba(224, 200, 142, 0.70) 100%);
}

.ornament-line-right::before {
  background: linear-gradient(to left,
    rgba(201, 169, 110, 0) 0%,
    rgba(201, 169, 110, 0.08) 20%,
    rgba(201, 169, 110, 0.22) 45%,
    rgba(201, 169, 110, 0.45) 70%,
    rgba(224, 200, 142, 0.70) 100%);
}

body[data-theme="bloodmoon"] .ornament-line-left::before {
  background: linear-gradient(to right,
    rgba(232, 160, 64, 0) 0%,
    rgba(232, 160, 64, 0.08) 20%,
    rgba(232, 160, 64, 0.22) 45%,
    rgba(232, 160, 64, 0.45) 70%,
    rgba(255, 208, 128, 0.70) 100%);
}

body[data-theme="bloodmoon"] .ornament-line-right::before {
  background: linear-gradient(to left,
    rgba(232, 160, 64, 0) 0%,
    rgba(232, 160, 64, 0.08) 20%,
    rgba(232, 160, 64, 0.22) 45%,
    rgba(232, 160, 64, 0.45) 70%,
    rgba(255, 208, 128, 0.70) 100%);
}

.orn {
  position: absolute;
  top: 50%;
  z-index: 2;
  display: block;
}

.ornament-line-left .orn { left: var(--pos); transform: translate(-50%, -50%); }
.ornament-line-right .orn { right: var(--pos); transform: translate(50%, -50%); }

.ornament-line-right .orn-diamond    { --pos: 82%; }
.ornament-line-right .orn-star       { --pos: 56%; }
.ornament-line-right .orn-diamond-sm { --pos: 34%; }
.ornament-line-right .orn-dot        { --pos: 16%; }

.orn-diamond {
  width: 10px; height: 10px;
  background: linear-gradient(135deg, #F0D9A0 0%, #C9A96E 60%, #8B6B3A 100%);
  transform: translate(-50%, -50%) rotate(45deg) !important;
  box-shadow: 0 0 5px rgba(201, 169, 110, 0.7), 0 0 12px rgba(201, 169, 110, 0.3);
  opacity: 0.95;
  border-radius: 1px;
}

body[data-theme="bloodmoon"] .orn-diamond {
  background: linear-gradient(135deg, #FFD080 0%, #E8A040 60%, #8B5A20 100%);
  box-shadow: 0 0 5px rgba(232, 160, 64, 0.7), 0 0 12px rgba(232, 160, 64, 0.3);
}

.orn-star {
  width: 11px; height: 11px;
  background: #C9A96E;
  clip-path: polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%);
  filter: drop-shadow(0 0 3px rgba(201, 169, 110, 0.6));
  opacity: 0.7;
}

body[data-theme="bloodmoon"] .orn-star {
  background: #E8A040;
  filter: drop-shadow(0 0 3px rgba(232, 160, 64, 0.6));
}

.orn-diamond-sm {
  width: 6px; height: 6px;
  background: #C9A96E;
  transform: translate(-50%, -50%) rotate(45deg) !important;
  opacity: 0.5;
  border-radius: 0.5px;
}

body[data-theme="bloodmoon"] .orn-diamond-sm { background: #E8A040; }

.orn-dot {
  width: 3px; height: 3px;
  background: #C9A96E;
  border-radius: 50%;
  opacity: 0.35;
}

body[data-theme="bloodmoon"] .orn-dot { background: #E8A040; }

.logo-wrap {
  position: relative;
  flex-shrink: 0;
  padding: 0 22px;
}

.logo {
  position: relative;
  z-index: 3;
  display: block;
  font-family: var(--font-gothic);
  font-size: clamp(28px, 3vw, 36px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  color: var(--accent-gold);
  text-decoration: none;
  text-shadow:
    0 0 4px rgba(240, 217, 160, 0.95),
    0 0 12px rgba(224, 200, 142, 0.80),
    0 0 26px rgba(201, 169, 110, 0.55),
    0 0 52px rgba(201, 169, 110, 0.30),
    0 0 96px rgba(139, 26, 74, 0.20),
    0 1px 2px rgba(0, 0, 0, 0.9);
  animation: logo-breathe 9s ease-in-out infinite;
  transition: text-shadow 0.5s ease, color 1.2s ease;
}

@keyframes logo-breathe {
  0%, 100% {
    text-shadow:
      0 0 4px rgba(240, 217, 160, 0.95),
      0 0 12px rgba(224, 200, 142, 0.80),
      0 0 26px rgba(201, 169, 110, 0.55),
      0 0 52px rgba(201, 169, 110, 0.30),
      0 0 96px rgba(139, 26, 74, 0.20),
      0 1px 2px rgba(0, 0, 0, 0.9);
  }
  50% {
    text-shadow:
      0 0 6px rgba(240, 217, 160, 1),
      0 0 16px rgba(224, 200, 142, 0.92),
      0 0 34px rgba(201, 169, 110, 0.68),
      0 0 68px rgba(201, 169, 110, 0.38),
      0 0 120px rgba(139, 26, 74, 0.26),
      0 1px 2px rgba(0, 0, 0, 0.9);
  }
}

.logo:hover {
  text-shadow:
    0 0 7px rgba(240, 217, 160, 1),
    0 0 20px rgba(224, 200, 142, 1),
    0 0 44px rgba(201, 169, 110, 0.8),
    0 0 88px rgba(201, 169, 110, 0.5),
    0 0 150px rgba(139, 26, 74, 0.32),
    0 1px 2px rgba(0, 0, 0, 0.9);
}

body[data-theme="bloodmoon"] .logo {
  color: #E8A040;
  text-shadow:
    0 0 4px rgba(255, 208, 128, 0.95),
    0 0 12px rgba(232, 160, 64, 0.80),
    0 0 26px rgba(232, 160, 64, 0.55),
    0 0 52px rgba(232, 160, 64, 0.30),
    0 0 96px rgba(196, 42, 42, 0.20),
    0 1px 2px rgba(0, 0, 0, 0.9);
}

.logo-wrap::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 220px; height: 70px;
  transform: translate(-50%, -50%);
  background: radial-gradient(ellipse at center,
    rgba(201, 169, 110, 0.18) 0%,
    rgba(201, 169, 110, 0.08) 40%,
    transparent 75%);
  filter: blur(10px);
  pointer-events: none;
  animation: halo-breathe 9s ease-in-out infinite;
  z-index: 1;
}

@keyframes halo-breathe {
  0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
}

/* ============== 右上角板块指示 ============== */
.section-indicator {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 4px 0 4px 24px;
  background: linear-gradient(
    to right,
    rgba(13, 11, 26, 0) 0%,
    rgba(13, 11, 26, 0.85) 30%,
    rgba(13, 11, 26, 0.95) 100%
  );
  font-family: var(--font-sharp);
  font-size: 11px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--accent-gold);
  white-space: nowrap;
  line-height: 1;
  opacity: 0;
  pointer-events: none;
  z-index: 5;
  transition: opacity 0.8s var(--ease-soft);
}

body[data-theme="bloodmoon"] .section-indicator {
  background: linear-gradient(
    to right,
    rgba(26, 10, 10, 0) 0%,
    rgba(26, 10, 10, 0.85) 30%,
    rgba(26, 10, 10, 0.95) 100%
  );
}

.section-indicator.visible {
  opacity: 1;
  animation: section-glow 7s ease-in-out infinite;
}

@keyframes section-glow {
  0%, 100% { text-shadow: 0 0 8px rgba(201, 169, 110, 0.35); }
  50% { text-shadow: 0 0 16px rgba(201, 169, 110, 0.65); }
}

/* ============== 404 主内容 ============== */
.not-found {
  min-height: calc(100vh - 80px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80px 32px;
  position: relative;
  z-index: 1;
}

.not-found-ornament {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 48px;
}

.not-found-ornament-line {
  width: 70px;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--border), transparent);
}

.not-found-ornament-sigil {
  font-family: var(--font-gothic);
  font-size: 22px;
  color: var(--accent);
  opacity: 0.75;
}

/* 404 数字 — 光晕减弱版 */
.not-found-code {
  font-family: var(--font-gothic);
  font-size: clamp(120px, 18vw, 200px);
  line-height: 1;
  color: var(--accent-gold);
  letter-spacing: 0.06em;
  margin-bottom: 40px;
  text-shadow:
    0 0 6px rgba(240, 217, 160, 0.65),
    0 0 20px rgba(224, 200, 142, 0.35),
    0 0 44px rgba(201, 169, 110, 0.18),
    0 0 90px rgba(139, 26, 74, 0.10);
  animation: not-found-breathe 6s ease-in-out infinite;
  transition: color 1.2s ease;
}

@keyframes not-found-breathe {
  0%, 100% {
    text-shadow:
      0 0 6px rgba(240, 217, 160, 0.65),
      0 0 20px rgba(224, 200, 142, 0.35),
      0 0 44px rgba(201, 169, 110, 0.18),
      0 0 90px rgba(139, 26, 74, 0.10);
  }
  50% {
    text-shadow:
      0 0 8px rgba(240, 217, 160, 0.78),
      0 0 26px rgba(224, 200, 142, 0.45),
      0 0 56px rgba(201, 169, 110, 0.24),
      0 0 116px rgba(139, 26, 74, 0.14);
  }
}

/* 血月模式：404 数字换暖橙色调 */
body[data-theme="bloodmoon"] .not-found-code {
  color: #E8A040;
  animation: not-found-breathe-blood 6s ease-in-out infinite;
}

@keyframes not-found-breathe-blood {
  0%, 100% {
    text-shadow:
      0 0 6px rgba(255, 208, 128, 0.65),
      0 0 20px rgba(232, 160, 64, 0.35),
      0 0 44px rgba(232, 160, 64, 0.18),
      0 0 90px rgba(196, 42, 42, 0.10);
  }
  50% {
    text-shadow:
      0 0 8px rgba(255, 208, 128, 0.78),
      0 0 26px rgba(232, 160, 64, 0.45),
      0 0 56px rgba(232, 160, 64, 0.24),
      0 0 116px rgba(196, 42, 42, 0.14);
  }
}

.not-found-text {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(20px, 2.2vw, 26px);
  color: var(--text-dim);
  letter-spacing: 0.03em;
  margin-bottom: 18px;
  max-width: 520px;
  line-height: 1.6;
}

.not-found-subtext {
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--text-faint);
  margin-bottom: 56px;
  max-width: 420px;
  line-height: 1.9;
}

.not-found-button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 34px;
  font-family: var(--font-sharp);
  font-size: 12px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--accent-gold);
  text-decoration: none;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: rgba(26, 23, 40, 0.5);
  transition: all 0.5s var(--ease-soft);
  position: relative;
  overflow: hidden;
}

.not-found-button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at center,
    rgba(201, 169, 110, 0.18) 0%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.5s var(--ease-soft);
  pointer-events: none;
}

.not-found-button:hover {
  border-color: var(--accent-gold);
  box-shadow:
    0 0 28px rgba(201, 169, 110, 0.35),
    inset 0 0 16px rgba(201, 169, 110, 0.1);
  transform: translateY(-2px);
  color: var(--accent-gold);
}

.not-found-button:hover::before { opacity: 1; }

.not-found-button-arrow {
  display: inline-block;
  transition: transform 0.4s var(--ease-soft);
}

.not-found-button:hover .not-found-button-arrow {
  transform: translateX(-4px);
}

.not-found-bottom {
  margin-top: 88px;
  display: flex;
  align-items: center;
  gap: 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--text-faint);
}

.not-found-bottom-line {
  width: 40px;
  height: 1px;
  background: var(--border-soft);
}

/* ============== 侧边轨道 ============== */
.side-orb {
  position: fixed;
  top: 50%;
  width: var(--orb-icon-size);
  height: var(--orb-icon-size);
  margin-top: calc(var(--orb-icon-size) / -2);
  z-index: 500;
  pointer-events: none;
}

.left-orb { left: 24px; }
.right-orb { right: 24px; }

.orb-ring {
  position: absolute;
  top: 50%; left: 50%;
  width: calc(var(--orb-radius) * 2);
  height: calc(var(--orb-radius) * 2);
  margin: calc(var(--orb-radius) * -1) 0 0 calc(var(--orb-radius) * -1);
  border-radius: 50%;
  border: 1px dashed rgba(201, 169, 110, 0.45);
  opacity: 0;
  transform: scale(0.3) rotate(-30deg);
  transition: opacity 0.5s ease, transform 0.7s var(--ease-spring), border-color 0.4s ease;
  pointer-events: none;
}

.side-orb.active .orb-ring {
  opacity: 0.7;
  transform: scale(1) rotate(0deg);
  border-color: var(--accent-gold);
}

.orb-icon {
  position: absolute;
  inset: 0;
  width: var(--orb-icon-size);
  height: var(--orb-icon-size);
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.4s ease, box-shadow 0.5s ease, transform 0.5s var(--ease-soft);
  z-index: 3;
  pointer-events: auto;
  overflow: hidden;
}

.orb-icon::before {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 169, 110, 0.18), transparent 70%);
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.orb-icon:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 24px rgba(201, 169, 110, 0.4);
}

.orb-icon:hover::before { opacity: 1; }

.side-orb.active .orb-icon {
  border-color: var(--accent-gold);
  animation: orb-pulse 3.5s ease-in-out infinite;
}

.side-orb.active .orb-icon::before { opacity: 1; }

@keyframes orb-pulse {
  0%, 100% { box-shadow: 0 0 28px rgba(201, 169, 110, 0.4); }
  50% { box-shadow: 0 0 44px rgba(201, 169, 110, 0.65); }
}

.orb-icon > svg {
  position: absolute;
  width: 26px; height: 26px;
  transition: opacity 0.5s ease, transform 0.7s var(--ease-spring);
}

.icon-moon, .icon-cross { opacity: 1; transform: rotate(0deg) scale(1); }
.icon-sun, .icon-bow { opacity: 0; transform: rotate(-120deg) scale(0.4); }

.side-orb.active .icon-moon,
.side-orb.active .icon-cross {
  opacity: 0;
  transform: rotate(120deg) scale(0.4);
}

.side-orb.active .icon-sun,
.side-orb.active .icon-bow {
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.orb-btn {
  --tx: 0px; --ty: 0px;
  --delay: 0ms; --close-delay: 0ms;
  position: absolute;
  top: 50%; left: 50%;
  width: var(--orb-btn-size);
  height: var(--orb-btn-size);
  margin: calc(var(--orb-btn-size) / -2) 0 0 calc(var(--orb-btn-size) / -2);
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--text-nav);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translate(0, 0) scale(0);
  transition: opacity 0.35s ease, transform 0.55s var(--ease-spring), border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  z-index: 1;
  pointer-events: none;
  transition-delay: var(--close-delay);
  text-decoration: none;
}

.orb-btn svg {
  width: 18px; height: 18px;
  transition: transform 0.4s var(--ease-soft);
}

.side-orb.active .orb-btn {
  opacity: 1;
  transform: translate(var(--tx), var(--ty)) scale(1);
  pointer-events: auto;
  transition-delay: var(--delay);
}

.orb-btn:hover {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.4);
}

.orb-btn:hover svg { transform: scale(1.15); }

.orb-btn::after {
  content: attr(data-label);
  position: absolute;
  top: 50%;
  left: calc(100% + 14px);
  transform: translateY(-50%) translateX(-6px);
  font-family: var(--font-sharp);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text);
  background: rgba(26, 23, 40, 0.95);
  border: 1px solid var(--border-soft);
  padding: 4px 10px;
  border-radius: 4px;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.orb-btn:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

.right-orb .orb-btn::after {
  left: auto;
  right: calc(100% + 14px);
  transform: translateY(-50%) translateX(6px);
}

.right-orb .orb-btn:hover::after {
  transform: translateY(-50%) translateX(0);
}

/* ============== 蜡烛 ============== */
.reading-candle {
  position: fixed;
  right: 48px; top: 25%;
  transform: translateY(-50%);
  width: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.6s ease;
}

.reading-candle.active { opacity: 1; }

.candle-flame {
  width: 12px; height: 22px;
  background: radial-gradient(ellipse at 50% 80%, #FFF4C0 0%, #E8B840 40%, #C9A96E 70%, transparent 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  filter: blur(0.5px);
  animation: flame-flicker 0.4s infinite alternate;
  transform-origin: 50% 100%;
  margin-bottom: -3px;
  position: relative;
  z-index: 2;
  transition: opacity 0.6s ease, transform 0.6s ease;
}

@keyframes flame-flicker {
  0% { transform: scaleY(1) scaleX(1) rotate(-2deg); opacity: 0.95; }
  50% { transform: scaleY(1.08) scaleX(0.92) rotate(1deg); opacity: 1; }
  100% { transform: scaleY(0.95) scaleX(1.05) rotate(-1deg); opacity: 0.9; }
}

.candle-wax {
  width: 14px;
  height: var(--candle-h);
  background: linear-gradient(180deg, #E8E4F0 0%, #B8B2C8 100%);
  border-radius: 2px 2px 4px 4px;
  position: relative;
  box-shadow: inset -2px 0 4px rgba(0, 0, 0, 0.2), 0 0 20px rgba(201, 169, 110, 0.15);
  transition: height 0.3s ease, opacity 0.6s ease;
}

.candle-wax::before {
  content: '';
  position: absolute;
  top: 0; left: -2px; right: -2px;
  height: 4px;
  background: #D4CFE0;
  border-radius: 50%;
}

.candle-base {
  width: 24px; height: 4px;
  background: linear-gradient(180deg, #4A3F6B 0%, #1A1728 100%);
  border-radius: 2px;
  margin-top: 2px;
}

.candle-smoke {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 4px; height: 4px;
  background: rgba(155, 148, 168, 0.5);
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
}

.reading-candle.extinguished .candle-flame {
  opacity: 0;
  transform: scaleY(0.2) scaleX(0.5);
}

.reading-candle.extinguished .candle-smoke {
  animation: smoke-rise 3s ease-out forwards;
}

@keyframes smoke-rise {
  0% { opacity: 0.6; transform: translateX(-50%) translateY(0) scale(1); }
  50% { opacity: 0.3; transform: translateX(-50%) translateY(-40px) scale(2.5); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-80px) scale(4); }
}

/* ============== 幽灵 ============== */
.ghost-companion {
  position: fixed;
  top: 0; left: 0;
  width: 36px; height: 44px;
  pointer-events: none;
  z-index: 9000;
  opacity: 0;
  transition: opacity 0.6s ease;
  filter: drop-shadow(0 0 14px rgba(139, 26, 74, 0.5));
  will-change: transform;
}

.ghost-companion.active { opacity: 1; }

.ghost-companion svg {
  width: 100%; height: 100%;
  animation: ghost-float 3s ease-in-out infinite;
}

@keyframes ghost-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-6px) rotate(2deg); }
}

.ghost-companion.startled {
  animation: ghost-startle 0.4s ease-out;
}

@keyframes ghost-startle {
  0% { transform: scale(1); }
  40% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* ============== 血月按钮 ============== */
.theme-toggle {
  position: fixed;
  right: 24px; bottom: 24px;
  width: 46px; height: 46px;
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  z-index: 9001;
  transition: all 0.4s var(--ease-soft);
}

.theme-toggle:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
  transform: translateY(-4px) rotate(15deg);
}

.theme-icon-bloodmoon { display: none; }
body[data-theme="bloodmoon"] .theme-icon-moon { display: none; }
body[data-theme="bloodmoon"] .theme-icon-bloodmoon { display: inline; }

/* ============== 返回顶部 ============== */
#back-to-top {
  position: fixed;
  left: 24px; bottom: 24px;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s var(--ease-soft);
  z-index: 9000;
}

#back-to-top.visible { opacity: 1; pointer-events: auto; }

#back-to-top:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
  transform: translateY(-4px);
}

/* ============== 响应式 ============== */
@media (max-width: 1280px) {
  .reading-candle { right: 20px; top: 22%; }
}

@media (max-width: 1024px) {
  .reading-candle { display: none; }
  :root {
    --orb-radius: 78px;
    --orb-icon-size: 50px;
    --orb-btn-size: 38px;
  }
  .left-orb { left: 16px; }
  .right-orb { right: 16px; }
}

@media (max-width: 768px) {
  body { font-size: 17px; }
  .top-bar-inner { padding: 18px 16px; }
  .logo-wrap { padding: 0 14px; }
  .orn-diamond-sm, .orn-dot { display: none; }
  .ornament-line-left .orn-diamond,
  .ornament-line-right .orn-diamond { --pos: 82% !important; }
  .ornament-line-left .orn-star,
  .ornament-line-right .orn-star { --pos: 40% !important; }
  .section-indicator { display: none; }
  .not-found { padding: 60px 24px; min-height: calc(100vh - 70px); }
  .not-found-ornament { margin-bottom: 32px; }
  .not-found-ornament-line { width: 50px; }
  .not-found-code { margin-bottom: 28px; }
  .not-found-text { margin-bottom: 14px; }
  .not-found-subtext { margin-bottom: 44px; font-size: 15px; }
  .not-found-button { padding: 14px 26px; font-size: 11px; letter-spacing: 0.22em; }
  .not-found-bottom { margin-top: 64px; }
  #back-to-top { left: 12px; bottom: 12px; width: 40px; height: 40px; }
  .theme-toggle { right: 12px; bottom: 12px; width: 40px; height: 40px; }
  .ghost-companion { display: none; }
  .side-orb { display: none; }
}

@media (max-width: 480px) {
  .logo { font-size: 24px; letter-spacing: 0.02em; }
  .logo-wrap { padding: 0 10px; }
  .logo-wrap::before { width: 160px; height: 56px; }
  .orn-star { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .orb-btn, .orb-ring, .orb-icon, .orb-icon > svg {
    transition-duration: 0.01ms !important;
  }
  .side-orb.active .orb-icon { animation: none; }
  .not-found-code { animation: none; }
  .section-indicator.visible { animation: none; }
}

::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--accent-purple); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

::selection { background: rgba(139, 26, 74, 0.5); color: var(--text); }
</style>
