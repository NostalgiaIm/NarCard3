html,body{margin:0;min-height:100%;background:var(--bg)!important;color:var(--text)!important;color-scheme:dark;transition:background 1.2s ease,color 1.2s ease;}
*{box-sizing:border-box}
button,a,.logo,.orb-btn,.orb-icon,.theme-toggle,#back-to-top,.hero-title,.hero-subtitle,.hero-hint,.page-title,.page-subtitle,.archive-year-num,.archive-year-count,.archive-date,.archive-link,.tag-chip,.tag-num,.tag-group-name,.tag-group-count,.gallery-title,.gallery-meta,.section-indicator,.loader,.loader *,.curtain-mark,.not-found-code,.not-found-text,.not-found-button,.not-found-ornament,.footer-sigil,.about-sigil{-webkit-user-select:none;-moz-user-select:none;user-select:none;-webkit-user-drag:none;}
button,a,img,svg{user-select:none;-webkit-user-select:none;-webkit-user-drag:none;}
.loader{position:fixed;inset:0;z-index:2147483647;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;transition:opacity .9s cubic-bezier(.4,0,.2,1),visibility .9s cubic-bezier(.4,0,.2,1)}
.loader.hidden{opacity:0;visibility:hidden;pointer-events:none}.loader::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 380px 460px at 50% 58%,rgba(201,169,110,.07) 0%,rgba(139,26,74,.04) 40%,transparent 75%);opacity:0;animation:ambient-in 2.2s ease-out .3s forwards;pointer-events:none}@keyframes ambient-in{to{opacity:1}}
.loader-scene{position:relative;display:flex;flex-direction:column;align-items:center;transform:translateY(-8px)}.loader-candle{width:7px;height:54px;background:linear-gradient(180deg,#F0E8F5 0%,#C8C0D8 55%,#8B7AB8 100%);border-radius:2px 2px 3px 3px;box-shadow:inset -2px 0 4px rgba(0,0,0,.3),0 0 20px rgba(201,169,110,.15);transform-origin:bottom center;transform:scaleY(0);animation:candle-grow .65s cubic-bezier(.34,1.56,.64,1) .1s forwards;position:relative}.loader-candle::before{content:'';position:absolute;top:-2px;left:-2px;right:-2px;height:4px;background:#D4CFE0;border-radius:50%}@keyframes candle-grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.loader-wick{width:2px;height:7px;background:#2A0F1A;border-radius:1px;position:relative;z-index:2;margin-bottom:-1px;transform-origin:bottom center;transform:scaleY(0);animation:wick-in .28s ease .68s forwards}@keyframes wick-in{to{transform:scaleY(1)}}.loader-flame{position:relative;width:16px;height:30px;margin-bottom:-4px;transform-origin:center bottom;transform:scale(0);opacity:0;animation:flame-ignite .85s cubic-bezier(.34,1.56,.64,1) .82s forwards;z-index:3}@keyframes flame-ignite{0%{transform:scale(0);opacity:0}55%{transform:scale(1.22);opacity:1}100%{transform:scale(1);opacity:1}}
.flame-shape{position:absolute;inset:0;background:radial-gradient(ellipse 50% 72% at 50% 72%,#FFF4C0 0%,#E8B840 28%,#C9A96E 55%,rgba(139,26,74,.55) 82%,transparent 100%);border-radius:50% 50% 50% 50%/65% 65% 35% 35%;filter:blur(.5px);transform-origin:50% 100%;animation:flame-dance .55s ease-in-out infinite alternate}.flame-shape::after{content:'';position:absolute;inset:26% 30% 22% 30%;background:radial-gradient(ellipse at 50% 60%,#fff 0%,#FFF4C0 45%,transparent 100%);border-radius:50%;filter:blur(1px);opacity:.9}@keyframes flame-dance{0%{transform:scaleY(1) scaleX(1) rotate(-2deg)}50%{transform:scaleY(1.08) scaleX(.92) rotate(1deg)}100%{transform:scaleY(.95) scaleX(1.05) rotate(-1deg)}}
.flame-glow{position:absolute;top:-38px;left:50%;width:140px;height:140px;transform:translateX(-50%);background:radial-gradient(circle at center,rgba(255,244,192,.34) 0%,rgba(232,184,64,.18) 22%,rgba(201,169,110,.08) 45%,transparent 72%);filter:blur(8px);opacity:0;pointer-events:none;animation:glow-in 1.4s ease-out 1.15s forwards,glow-pulse 2.6s ease-in-out 2.55s infinite}@keyframes glow-in{from{opacity:0;transform:translateX(-50%) scale(.4)}to{opacity:1;transform:translateX(-50%) scale(1)}}@keyframes glow-pulse{0%,100%{opacity:.85;transform:translateX(-50%) scale(1)}50%{opacity:1;transform:translateX(-50%) scale(1.07)}}
.loader-caption{margin-top:48px;font-family:'Grenze','LXGW WenKai','PingFang SC','Microsoft YaHei',serif;font-size:15px;letter-spacing:.4em;padding-left:.4em;color:#C9A96E;opacity:0;animation:caption-in 1.2s ease 1.55s forwards,caption-pulse 2.8s ease-in-out 2.75s infinite;text-shadow:0 0 10px rgba(201,169,110,.55),0 0 28px rgba(201,169,110,.22)}@keyframes caption-in{to{opacity:.85}}@keyframes caption-pulse{0%,100%{opacity:.75}50%{opacity:.95}}
@media (prefers-reduced-motion:reduce){.loader-candle,.loader-wick,.loader-flame,.flame-shape,.flame-glow,.loader-caption{animation-duration:.01ms!important;animation-iteration-count:1!important;animation-fill-mode:forwards!important}}
</style>
