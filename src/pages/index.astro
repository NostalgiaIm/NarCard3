---
import BackgroundMusic from '../components/global/BackgroundMusic.astro';
import { posts, tagCounts, type DemoPost } from '../data/posts';

// ============================================
//  演示内容数据层（模板化展示内容，正式使用时另行撰写）
// ============================================
const years = [...new Set(posts.map((p) => Number(p.iso.slice(0, 4))))].sort((a, b) => b - a);
const grouped = years.map((year) => ({
  year,
  items: posts
    .filter((p) => Number(p.iso.slice(0, 4)) === year)
    .sort((a, b) => b.iso.localeCompare(a.iso)),
}));

const esc = (s: unknown) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// 代码块：自带语言标签（可编辑）与复制按钮
function codeBlock(lang: string, code: string) {
  return (
    '<div class="code-block" data-lang="' + lang + '">' +
      '<div class="code-head">' +
        '<span class="code-lang" contenteditable="true" spellcheck="false" role="textbox" aria-label="语言类型">' + esc(lang) + '</span>' +
        '<button class="code-copy" type="button" aria-label="复制代码">复制</button>' +
      '</div>' +
      '<pre><code>' + esc(code) + '</code></pre>' +
    '</div>'
  );
}

function articleBody(post: DemoPost) {
  return [
    `<p><strong>${esc(post.excerpt || 'A short example entry for demonstrating the template.')}</strong></p>`,
    '<p>This is neutral example content for the public template. Replace it with your own writing, documentation, or design notes.</p>',
    '<h2>Getting started</h2>',
    '<p>Use this structure as a starting point for a long-form article. Headings, paragraphs, links, code blocks, tables, callouts, and mathematical notation are supported.</p>',
    codeBlock('bash', 'npm install\nnpm run dev'),
    '<h2>Continue writing</h2>',
    '<p>Replace this example with content that belongs to your own project.</p>',
  ].join('\\n');
}
const postsWithBody = posts.map((post) => ({
  ...post,
  readTime: 4 + (post.title.length % 7),
  body: articleBody(post),
}));

const nocturneData = { posts: postsWithBody, tags: tagCounts };
const homeCanonical = new URL('/', Astro.site ?? Astro.url).toString();
const homeDescription = 'A Gothic Journal — Where shadows write and silence speaks.';
---

