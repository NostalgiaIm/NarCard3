<script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<style is:global>
:root {
  --bg: #0D0B1A;
  --bg-panel: #1A1728;
  --bg-code: #12101C;
  --bg-glass: rgba(26, 23, 40, 0.72);
  --text: #E8E4F0;
  --text-dim: #9B94A8;
  --text-faint: #5A5470;
  --text-nav: #B8B2C8;
  --accent: #8B1A4A;
  --accent-bright: #B02A5A;
  --accent-gold: #C9A96E;
  --accent-purple: #4A3F6B;
  --border: rgba(74, 63, 107, 0.35);
  --border-soft: rgba(74, 63, 107, 0.15);
  --top-bar-bg: rgba(13, 11, 26, 0.92);
  --bg-glow-main: rgba(139, 26, 74, 0.16);
  --bg-glow-side: rgba(74, 63, 107, 0.14);
  --bg-overlay: rgba(13, 11, 26, 0.72);

  --font-gothic: 'UnifrakturMaguntia', serif;
  --font-sharp: 'Cinzel', serif;
  --font-serif: 'Cormorant Garamond', serif;
  --font-body: 'Grenze', 'LXGW WenKai', 'Noto Serif SC', serif;
  --font-mono: 'JetBrains Mono', monospace;

  --ease-slow: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-soft: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-curtain: cubic-bezier(0.65, 0, 0.35, 1);

  --candle-h: 140px;
  --orb-radius: 90px;
  --orb-icon-size: 56px;
  --orb-btn-size: 42px;
}

body[data-theme="bloodmoon"] {
  --bg: #1A0A0A;
  --bg-panel: #2A1212;
  --bg-code: #1A0808;
  --bg-glass: rgba(42, 18, 18, 0.72);
  --text: #F0E0E0;
  --text-dim: #B88A8A;
  --text-faint: #6B4040;
  --text-nav: #D0A8A8;
  --accent: #C42A2A;
  --accent-bright: #E03A3A;
  --accent-gold: #E8A040;
  --accent-purple: #6B2A2A;
  --border: rgba(140, 60, 60, 0.4);
  --border-soft: rgba(140, 60, 60, 0.2);
  --top-bar-bg: rgba(26, 10, 10, 0.92);
  --bg-glow-main: rgba(196, 42, 42, 0.24);
  --bg-glow-side: rgba(107, 42, 42, 0.22);
  --bg-overlay: rgba(26, 10, 10, 0.76);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

html {
  background: var(--bg);
  transition: background 1.2s ease;
}

body {
  background: radial-gradient(circle at 18% 8%, var(--bg-glow-main), transparent 34rem),
              radial-gradient(circle at 86% 18%, var(--bg-glow-side), transparent 38rem),
              var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 19px;
  line-height: 1.95;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
  transition: background 1.2s ease, color 1.2s ease;
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.035;
  pointer-events: none;
  z-index: 9998;
}

#particles-canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
#cursor-trail { position: fixed; inset: 0; z-index: 9997; pointer-events: none; }

#scroll-progress {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent-purple), var(--accent), var(--accent-gold));
  width: 0%;
  z-index: 10000;
  transition: width 0.1s linear;
  box-shadow: 0 0 12px rgba(201, 169, 110, 0.5);
}

.container-narrow {
  max-width: 824px;
  margin: 0 auto;
  padding: 0 32px;
  position: relative;
  z-index: 1;
}

.container-gallery {
  max-width: 1040px;
  margin: 0 auto;
  padding: 0 40px;
  position: relative;
  z-index: 1;
}

/* ============== 顶部栏 ============== */
.top-bar {
  position: sticky; top: 0; z-index: 100;
  background: var(--top-bar-bg);
  transition: background 1.2s ease;
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px 24px;
}

.ornament-line {
  position: relative;
  flex: 1;
  height: 26px;
  min-width: 40px;
}

.ornament-line::before {
  content: '';
  position: absolute;
  top: 50%; left: 0; right: 0;
  height: 1px;
  transform: translateY(-50%);
  z-index: 1;
}

.ornament-line-left::before {
  background: linear-gradient(to right,
    rgba(201, 169, 110, 0) 0%,
    rgba(201, 169, 110, 0.08) 20%,
    rgba(201, 169, 110, 0.22) 45%,
    rgba(201, 169, 110, 0.45) 70%,
    rgba(224, 200, 142, 0.70) 100%);
}

.ornament-line-right::before {
  background: linear-gradient(to left,
    rgba(201, 169, 110, 0) 0%,
    rgba(201, 169, 110, 0.08) 20%,
    rgba(201, 169, 110, 0.22) 45%,
    rgba(201, 169, 110, 0.45) 70%,
    rgba(224, 200, 142, 0.70) 100%);
}

body[data-theme="bloodmoon"] .ornament-line-left::before {
  background: linear-gradient(to right,
    rgba(232, 160, 64, 0) 0%,
    rgba(232, 160, 64, 0.08) 20%,
    rgba(232, 160, 64, 0.22) 45%,
    rgba(232, 160, 64, 0.45) 70%,
    rgba(255, 208, 128, 0.70) 100%);
}

body[data-theme="bloodmoon"] .ornament-line-right::before {
  background: linear-gradient(to left,
    rgba(232, 160, 64, 0) 0%,
    rgba(232, 160, 64, 0.08) 20%,
    rgba(232, 160, 64, 0.22) 45%,
    rgba(232, 160, 64, 0.45) 70%,
    rgba(255, 208, 128, 0.70) 100%);
}

.orn {
  position: absolute;
  top: 50%;
  z-index: 2;
  display: block;
}

.ornament-line-left .orn { left: var(--pos); transform: translate(-50%, -50%); }
.ornament-line-right .orn { right: var(--pos); transform: translate(50%, -50%); }

.ornament-line-right .orn-diamond    { --pos: 82%; }
.ornament-line-right .orn-star       { --pos: 56%; }
.ornament-line-right .orn-diamond-sm { --pos: 34%; }
.ornament-line-right .orn-dot        { --pos: 16%; }

.orn-diamond {
  width: 10px; height: 10px;
  background: linear-gradient(135deg, #F0D9A0 0%, #C9A96E 60%, #8B6B3A 100%);
  transform: translate(-50%, -50%) rotate(45deg) !important;
  box-shadow: 0 0 5px rgba(201, 169, 110, 0.7), 0 0 12px rgba(201, 169, 110, 0.3);
  opacity: 0.95;
  border-radius: 1px;
}

body[data-theme="bloodmoon"] .orn-diamond {
  background: linear-gradient(135deg, #FFD080 0%, #E8A040 60%, #8B5A20 100%);
  box-shadow: 0 0 5px rgba(232, 160, 64, 0.7), 0 0 12px rgba(232, 160, 64, 0.3);
}

.orn-star {
  width: 11px; height: 11px;
  background: #C9A96E;
  clip-path: polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%);
  filter: drop-shadow(0 0 3px rgba(201, 169, 110, 0.6));
  opacity: 0.7;
}

body[data-theme="bloodmoon"] .orn-star {
  background: #E8A040;
  filter: drop-shadow(0 0 3px rgba(232, 160, 64, 0.6));
}

.orn-diamond-sm {
  width: 6px; height: 6px;
  background: #C9A96E;
  transform: translate(-50%, -50%) rotate(45deg) !important;
  opacity: 0.5;
  border-radius: 0.5px;
}

body[data-theme="bloodmoon"] .orn-diamond-sm { background: #E8A040; }

.orn-dot {
  width: 3px; height: 3px;
  background: #C9A96E;
  border-radius: 50%;
  opacity: 0.35;
}

body[data-theme="bloodmoon"] .orn-dot { background: #E8A040; }

.logo-wrap {
  position: relative;
  flex-shrink: 0;
  padding: 0 22px;
}

.logo {
  position: relative;
  z-index: 3;
  display: block;
  font-family: var(--font-gothic);
  font-size: clamp(28px, 3vw, 36px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.04em;
  color: var(--accent-gold);
  text-decoration: none;
  cursor: pointer;
  text-shadow:
    0 0 4px rgba(240, 217, 160, 0.95),
    0 0 12px rgba(224, 200, 142, 0.80),
    0 0 26px rgba(201, 169, 110, 0.55),
    0 0 52px rgba(201, 169, 110, 0.30),
    0 0 96px rgba(139, 26, 74, 0.20),
    0 1px 2px rgba(0, 0, 0, 0.9);
  animation: logo-breathe 9s ease-in-out infinite;
  transition: text-shadow 0.5s ease, color 1.2s ease;
}

@keyframes logo-breathe {
  0%, 100% {
    text-shadow:
      0 0 4px rgba(240, 217, 160, 0.95),
      0 0 12px rgba(224, 200, 142, 0.80),
      0 0 26px rgba(201, 169, 110, 0.55),
      0 0 52px rgba(201, 169, 110, 0.30),
      0 0 96px rgba(139, 26, 74, 0.20),
      0 1px 2px rgba(0, 0, 0, 0.9);
  }
  50% {
    text-shadow:
      0 0 6px rgba(240, 217, 160, 1),
      0 0 16px rgba(224, 200, 142, 0.92),
      0 0 34px rgba(201, 169, 110, 0.68),
      0 0 68px rgba(201, 169, 110, 0.38),
      0 0 120px rgba(139, 26, 74, 0.26),
      0 1px 2px rgba(0, 0, 0, 0.9);
  }
}

.logo:hover {
  text-shadow:
    0 0 7px rgba(240, 217, 160, 1),
    0 0 20px rgba(224, 200, 142, 1),
    0 0 44px rgba(201, 169, 110, 0.8),
    0 0 88px rgba(201, 169, 110, 0.5),
    0 0 150px rgba(139, 26, 74, 0.32),
    0 1px 2px rgba(0, 0, 0, 0.9);
}

body[data-theme="bloodmoon"] .logo {
  color: #E8A040;
  text-shadow:
    0 0 4px rgba(255, 208, 128, 0.95),
    0 0 12px rgba(232, 160, 64, 0.80),
    0 0 26px rgba(232, 160, 64, 0.55),
    0 0 52px rgba(232, 160, 64, 0.30),
    0 0 96px rgba(196, 42, 42, 0.20),
    0 1px 2px rgba(0, 0, 0, 0.9);
}

.logo-wrap::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 220px; height: 70px;
  transform: translate(-50%, -50%);
  background: radial-gradient(ellipse at center,
    rgba(201, 169, 110, 0.18) 0%,
    rgba(201, 169, 110, 0.08) 40%,
    transparent 75%);
  filter: blur(10px);
  pointer-events: none;
  animation: halo-breathe 9s ease-in-out infinite;
  z-index: 1;
}

@keyframes halo-breathe {
  0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
}

.section-indicator {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 4px 0 4px 24px;
  background: linear-gradient(
    to right,
    rgba(13, 11, 26, 0) 0%,
    rgba(13, 11, 26, 0.85) 30%,
    rgba(13, 11, 26, 0.95) 100%
  );
  font-family: var(--font-sharp);
  font-size: 11px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--accent-gold);
  white-space: nowrap;
  line-height: 1;
  opacity: 0;
  pointer-events: none;
  z-index: 5;
  transition: opacity 0.8s var(--ease-soft);
}

body[data-theme="bloodmoon"] .section-indicator {
  background: linear-gradient(
    to right,
    rgba(26, 10, 10, 0) 0%,
    rgba(26, 10, 10, 0.85) 30%,
    rgba(26, 10, 10, 0.95) 100%
  );
}

.section-indicator.visible {
  opacity: 1;
  animation: section-glow 7s ease-in-out infinite;
}

@keyframes section-glow {
  0%, 100% { text-shadow: 0 0 8px rgba(201, 169, 110, 0.35); }
  50% { text-shadow: 0 0 16px rgba(201, 169, 110, 0.65); }
}

/* ============== 视图容器 ============== */
main {
  position: relative;
  z-index: 1;
}

.view[hidden] { display: none; }

.view {
  min-height: calc(100vh - 80px);
}

/* ============== Home 视图 ============== */
.hero {
  text-align: center;
  padding: 160px 32px 120px;
}

.hero-title {
  font-family: var(--font-gothic);
  font-size: clamp(56px, 9vw, 108px);
  color: var(--accent-gold);
  line-height: 1.05;
  margin-bottom: 24px;
  text-shadow:
    0 0 6px rgba(240, 217, 160, 0.65),
    0 0 20px rgba(224, 200, 142, 0.35),
    0 0 50px rgba(201, 169, 110, 0.18);
  animation: hero-breathe 8s ease-in-out infinite;
}

@keyframes hero-breathe {
  0%, 100% {
    text-shadow:
      0 0 6px rgba(240, 217, 160, 0.65),
      0 0 20px rgba(224, 200, 142, 0.35),
      0 0 50px rgba(201, 169, 110, 0.18);
  }
  50% {
    text-shadow:
      0 0 9px rgba(240, 217, 160, 0.85),
      0 0 28px rgba(224, 200, 142, 0.5),
      0 0 70px rgba(201, 169, 110, 0.26);
  }
}

.hero-subtitle {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(20px, 2.2vw, 26px);
  color: var(--text-dim);
  letter-spacing: 0.04em;
  margin-bottom: 48px;
}

.hero-hint {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  padding: 14px 28px;
  font-family: var(--font-sharp);
  font-size: 11px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--text-dim);
  border: 1px solid var(--border-soft);
  border-radius: 100px;
  background: rgba(26, 23, 40, 0.4);
}

.hero-hint-arrow {
  color: var(--accent-gold);
  font-family: var(--font-gothic);
  font-size: 16px;
  animation: hint-pulse 2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%, 100% { opacity: 0.6; transform: translateX(0); }
  50% { opacity: 1; transform: translateX(4px); }
}

/* ============== 页面通用（内页） ============== */
.page {
  padding: 100px 0 80px;
}

.page-header {
  text-align: center;
  margin-bottom: 72px;
  padding-bottom: 48px;
  border-bottom: 1px solid var(--border-soft);
  position: relative;
}

.page-header::after {
  content: '❦';
  position: absolute;
  bottom: -13px; left: 50%;
  transform: translateX(-50%);
  background: var(--bg);
  padding: 0 20px;
  color: var(--accent);
  font-size: 18px;
  opacity: 0.7;
  transition: background 1.2s ease;
}

.page-title {
  font-family: var(--font-gothic);
  font-size: clamp(48px, 7vw, 84px);
  color: var(--accent-gold);
  line-height: 1.05;
  margin-bottom: 18px;
  text-shadow: 0 0 50px rgba(201, 169, 110, 0.2);
  transition: color 1.2s ease;
}

.page-subtitle {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(15px, 1.7vw, 20px);
  color: var(--text-dim);
  letter-spacing: 0.04em;
}

/* Archive */
.archive-year { margin-bottom: 64px; }

.archive-year-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-soft);
  position: relative;
}

.archive-year-head::before {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 70px; height: 1px;
  background: var(--accent-gold);
  box-shadow: 0 0 12px rgba(201, 169, 110, 0.6);
}

.archive-year-num {
  font-family: var(--font-gothic);
  font-size: clamp(40px, 5vw, 64px);
  color: var(--accent-gold);
  line-height: 1;
  text-shadow: 0 0 30px rgba(201, 169, 110, 0.2);
  transition: color 1.2s ease;
}

.archive-year-count {
  font-family: var(--font-sharp);
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--text-faint);
}

.archive-list { list-style: none; }

.archive-item {
  display: grid;
  grid-template-columns: 88px 1fr;
  align-items: baseline;
  gap: 28px;
  padding: 20px 0;
  border-bottom: 1px solid var(--border-soft);
  position: relative;
  transition: padding-left 0.4s var(--ease-soft);
}

.archive-item:last-child { border-bottom: none; }

.archive-item::before {
  content: '';
  position: absolute;
  left: -32px; top: 0; bottom: 0;
  width: 2px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform 0.4s var(--ease-soft);
}

.archive-item:hover { padding-left: 16px; }
.archive-item:hover::before { transform: scaleY(1); }

.archive-date {
  font-family: var(--font-sharp);
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-dim);
  white-space: nowrap;
  padding-top: 8px;
}

.archive-link {
  font-family: var(--font-gothic);
  font-size: 28px;
  line-height: 1.3;
  color: var(--text);
  text-decoration: none;
  transition: color 0.4s, text-shadow 0.4s;
}

.archive-item:hover .archive-link {
  color: var(--accent-gold);
  text-shadow: 0 0 24px rgba(201, 169, 110, 0.35);
}

/* Tags */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: baseline;
  gap: 14px 20px;
}

.tag-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
  /* 所有标签统一尺寸，不再按文章数量缩放 */
  padding: 9px 20px;
  font-size: 18px;
  border: 1px solid var(--border-soft);
  border-radius: 100px;
  background: rgba(26, 23, 40, 0.3);
  color: var(--text-nav);
  text-decoration: none;
  font-family: var(--font-gothic);
  line-height: 1;
  transition: all 0.4s var(--ease-soft);
}

.tag-chip .tag-num {
  font-family: var(--font-mono);
  font-size: 0.55em;
  color: var(--text-faint);
  transition: color 0.4s var(--ease-soft);
}

.tag-chip:hover {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
  background: rgba(201, 169, 110, 0.06);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.25);
  transform: translateY(-2px);
}

.tag-chip:hover .tag-num { color: var(--accent-gold); }

/* Tags 标题 + 字体切换圆钮（G 哥特体 / C 易读体） */
.tag-title-row {
  display: inline-flex;
  align-items: center;
  gap: 20px;
}
/* 行内布局下由 flex 控制间距，去掉标题自身的下边距避免错位 */
.tag-title-row .page-title { margin-bottom: 0; }
.font-toggle {
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: rgba(26, 23, 40, 0.92);
  color: var(--accent-gold);
  font-family: var(--font-sharp);
  font-size: 17px;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16px;
  transition: all 0.35s var(--ease-soft);
}
.font-toggle:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
  transform: translateY(-2px);
}
.font-toggle.readable {
  border-color: var(--accent-gold);
  box-shadow: 0 0 18px rgba(201, 169, 110, 0.22);
}

/* 易读模式：标签按钮与标签下的文章标题换成易读哥特体
   注意：标签分组大标题 .archive-year-num 保持不变 */
#tagsView.readable .tag-chip {
  font-family: var(--font-body);
  font-size: 17px;
  letter-spacing: 0.01em;
}
#tagsView.readable .archive-list .archive-link {
  font-family: var(--font-body);
  font-size: 24px;
  letter-spacing: 0.01em;
  line-height: 1.45;
}

/* Gallery */
.gallery {
  column-count: 2;
  column-gap: 40px;
}

.gallery-item {
  break-inside: avoid;
  margin-bottom: 48px;
  display: block;
}

.gallery-frame {
  position: relative;
  padding: 12px;
  background: linear-gradient(180deg, #1A1728 0%, #0D0B1A 100%);
  border: 1px solid rgba(201, 169, 110, 0.28);
  box-shadow:
    inset 0 0 30px rgba(0, 0, 0, 0.7),
    0 10px 40px rgba(0, 0, 0, 0.6),
    0 0 40px rgba(201, 169, 110, 0.05);
  transition: all 0.6s var(--ease-soft);
  overflow: hidden;
}

.gallery-frame img {
  display: block;
  width: 100%;
  height: auto;
  filter: sepia(0.18) brightness(0.82) contrast(1.08) saturate(0.9);
  transition: filter 0.9s var(--ease-soft), transform 0.9s var(--ease-soft);
}

.gallery-item:hover .gallery-frame {
  border-color: var(--accent-gold);
  transform: translateY(-4px);
  box-shadow:
    inset 0 0 30px rgba(0, 0, 0, 0.7),
    0 14px 50px rgba(0, 0, 0, 0.7),
    0 0 60px rgba(201, 169, 110, 0.2);
}

.gallery-item:hover .gallery-frame img {
  filter: sepia(0) brightness(1) contrast(1.02) saturate(1.05);
  transform: scale(1.02);
}

.gallery-caption {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.gallery-title {
  font-family: var(--font-gothic);
  font-size: 22px;
  line-height: 1.3;
  color: var(--text);
  transition: color 0.4s, text-shadow 0.4s;
}

.gallery-item:hover .gallery-title {
  color: var(--accent-gold);
  text-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
}

.gallery-meta {
  font-family: var(--font-sharp);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-faint);
}

/* About */
.about-body {
  font-family: var(--font-body);
  font-size: 19px;
  line-height: 2.05;
  letter-spacing: 0.015em;
  color: var(--text);
}

.about-body p { margin-bottom: 1.7em; }

.about-body h2 {
  font-family: var(--font-gothic);
  font-size: 36px;
  color: var(--accent-gold);
  margin: 56px 0 22px;
  line-height: 1.25;
}

.about-body h2::before {
  content: '❦';
  color: var(--accent);
  margin-right: 14px;
  font-size: 20px;
  vertical-align: middle;
  opacity: 0.65;
}

.about-body strong { color: var(--accent-gold); font-weight: 600; }
.about-body em {
  font-family: var(--font-serif);
  font-style: italic;
  color: var(--text-dim);
  font-size: 1.05em;
}

.about-body blockquote {
  margin: 40px 0;
  padding: 24px 32px;
  border-left: 3px solid var(--accent);
  background: linear-gradient(90deg, rgba(139, 26, 74, 0.08), transparent);
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 22px;
  line-height: 1.7;
  color: var(--text-dim);
  border-radius: 0 4px 4px 0;
  position: relative;
}

/* ============== 幕布过渡 ============== */
.curtain-transition {
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  overflow: hidden;
}

.curtain-panel {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 51%;
  transition: transform 0.6s var(--ease-curtain);
  will-change: transform;
  /* 深紫红幕布：褶皱 + 底色 */
  background:
    repeating-linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.5) 0px,
      rgba(0, 0, 0, 0.15) 14px,
      rgba(201, 169, 110, 0.05) 28px,
      rgba(0, 0, 0, 0.15) 42px,
      rgba(0, 0, 0, 0.5) 56px
    ),
    repeating-linear-gradient(
      88deg,
      rgba(74, 63, 107, 0.15) 0px,
      rgba(0, 0, 0, 0) 30px,
      rgba(74, 63, 107, 0.15) 60px
    ),
    linear-gradient(
      180deg,
      #2A0A18 0%,
      #1A0612 50%,
      #0E0308 100%
    );
}

body[data-theme="bloodmoon"] .curtain-panel {
  background:
    repeating-linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.5) 0px,
      rgba(0, 0, 0, 0.15) 14px,
      rgba(232, 160, 64, 0.05) 28px,
      rgba(0, 0, 0, 0.15) 42px,
      rgba(0, 0, 0, 0.5) 56px
    ),
    repeating-linear-gradient(
      88deg,
      rgba(140, 60, 60, 0.15) 0px,
      rgba(0, 0, 0, 0) 30px,
      rgba(140, 60, 60, 0.15) 60px
    ),
    linear-gradient(
      180deg,
      #3A0808 0%,
      #2A0404 50%,
      #150202 100%
    );
}

.curtain-panel-left {
  left: 0;
  transform: translateX(-101%);
  box-shadow: inset -60px 0 80px rgba(0, 0, 0, 0.5);
}

.curtain-panel-right {
  right: 0;
  transform: translateX(101%);
  box-shadow: inset 60px 0 80px rgba(0, 0, 0, 0.5);
}

/* 中央接缝的金色细线 */
.curtain-panel-left::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 1px;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(201, 169, 110, 0.4) 20%,
    rgba(240, 217, 160, 1) 50%,
    rgba(201, 169, 110, 0.4) 80%,
    transparent 100%
  );
  box-shadow: 0 0 16px rgba(201, 169, 110, 0.7);
}

body[data-theme="bloodmoon"] .curtain-panel-left::after {
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(232, 160, 64, 0.4) 20%,
    rgba(255, 208, 128, 1) 50%,
    rgba(232, 160, 64, 0.4) 80%,
    transparent 100%
  );
  box-shadow: 0 0 16px rgba(232, 160, 64, 0.7);
}

.curtain-transition.active .curtain-panel {
  transform: translateX(0);
}

/* 中央标记 */
.curtain-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.6);
  font-family: var(--font-gothic);
  font-size: 56px;
  color: var(--accent-gold);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.5s var(--ease-spring);
  text-shadow:
    0 0 12px rgba(240, 217, 160, 0.9),
    0 0 32px rgba(201, 169, 110, 0.6),
    0 0 80px rgba(139, 26, 74, 0.4);
}

body[data-theme="bloodmoon"] .curtain-mark {
  color: #E8A040;
  text-shadow:
    0 0 12px rgba(255, 208, 128, 0.9),
    0 0 32px rgba(232, 160, 64, 0.6),
    0 0 80px rgba(196, 42, 42, 0.4);
}

.curtain-mark.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ============== 侧边轨道 ============== */
.side-orb {
  position: fixed;
  top: 50%;
  width: var(--orb-icon-size);
  height: var(--orb-icon-size);
  margin-top: calc(var(--orb-icon-size) / -2);
  z-index: 500;
  pointer-events: none;
}

.left-orb { left: 24px; }
.right-orb { right: 24px; }

.orb-ring {
  position: absolute;
  top: 50%; left: 50%;
  width: calc(var(--orb-radius) * 2);
  height: calc(var(--orb-radius) * 2);
  margin: calc(var(--orb-radius) * -1) 0 0 calc(var(--orb-radius) * -1);
  border-radius: 50%;
  border: 1px dashed rgba(201, 169, 110, 0.45);
  opacity: 0;
  transform: scale(0.3) rotate(-30deg);
  transition: opacity 0.5s ease, transform 0.7s var(--ease-spring), border-color 0.4s ease;
  pointer-events: none;
}

.side-orb.active .orb-ring {
  opacity: 0.7;
  transform: scale(1) rotate(0deg);
  border-color: var(--accent-gold);
}

.orb-icon {
  position: absolute;
  inset: 0;
  width: var(--orb-icon-size);
  height: var(--orb-icon-size);
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.4s ease, box-shadow 0.5s ease, transform 0.5s var(--ease-soft);
  z-index: 3;
  pointer-events: auto;
  overflow: hidden;
}

.orb-icon::before {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 169, 110, 0.18), transparent 70%);
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.orb-icon:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 24px rgba(201, 169, 110, 0.4);
}

.orb-icon:hover::before { opacity: 1; }

.side-orb.active .orb-icon {
  border-color: var(--accent-gold);
  animation: orb-pulse 3.5s ease-in-out infinite;
}

.side-orb.active .orb-icon::before { opacity: 1; }

@keyframes orb-pulse {
  0%, 100% { box-shadow: 0 0 28px rgba(201, 169, 110, 0.4); }
  50% { box-shadow: 0 0 44px rgba(201, 169, 110, 0.65); }
}

.orb-icon > svg {
  position: absolute;
  width: 26px; height: 26px;
  transition: opacity 0.5s ease, transform 0.7s var(--ease-spring);
}

.icon-moon, .icon-cross { opacity: 1; transform: rotate(0deg) scale(1); }
.icon-sun, .icon-bow { opacity: 0; transform: rotate(-120deg) scale(0.4); }

.side-orb.active .icon-moon,
.side-orb.active .icon-cross {
  opacity: 0;
  transform: rotate(120deg) scale(0.4);
}

.side-orb.active .icon-sun,
.side-orb.active .icon-bow {
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.orb-btn {
  --tx: 0px; --ty: 0px;
  --delay: 0ms; --close-delay: 0ms;
  position: absolute;
  top: 50%; left: 50%;
  width: var(--orb-btn-size);
  height: var(--orb-btn-size);
  margin: calc(var(--orb-btn-size) / -2) 0 0 calc(var(--orb-btn-size) / -2);
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--text-nav);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translate(0, 0) scale(0);
  transition: opacity 0.35s ease, transform 0.55s var(--ease-spring), border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  z-index: 1;
  pointer-events: none;
  transition-delay: var(--close-delay);
  text-decoration: none;
}

.orb-btn svg {
  width: 18px; height: 18px;
  transition: transform 0.4s var(--ease-soft);
}

.side-orb.active .orb-btn {
  opacity: 1;
  transform: translate(var(--tx), var(--ty)) scale(1);
  pointer-events: auto;
  transition-delay: var(--delay);
}

.orb-btn:hover {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.4);
}

.orb-btn:hover svg { transform: scale(1.15); }

.orb-btn::after {
  content: attr(data-label);
  position: absolute;
  top: 50%;
  left: calc(100% + 14px);
  transform: translateY(-50%) translateX(-6px);
  font-family: var(--font-sharp);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text);
  background: rgba(26, 23, 40, 0.95);
  border: 1px solid var(--border-soft);
  padding: 4px 10px;
  border-radius: 4px;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.orb-btn:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

.right-orb .orb-btn::after {
  left: auto;
  right: calc(100% + 14px);
  transform: translateY(-50%) translateX(6px);
}

.right-orb .orb-btn:hover::after {
  transform: translateY(-50%) translateX(0);
}

/* ============== 蜡烛 ============== */
.reading-candle {
  position: fixed;
  right: 48px; top: 25%;
  transform: translateY(-50%);
  width: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.6s ease;
}

.reading-candle.active { opacity: 1; }

.candle-flame {
  width: 12px; height: 22px;
  background: radial-gradient(ellipse at 50% 80%, #FFF4C0 0%, #E8B840 40%, #C9A96E 70%, transparent 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  filter: blur(0.5px);
  animation: flame-flicker 0.4s infinite alternate;
  transform-origin: 50% 100%;
  margin-bottom: -3px;
  position: relative;
  z-index: 2;
  transition: opacity 0.6s ease, transform 0.6s ease;
}

@keyframes flame-flicker {
  0% { transform: scaleY(1) scaleX(1) rotate(-2deg); opacity: 0.95; }
  50% { transform: scaleY(1.08) scaleX(0.92) rotate(1deg); opacity: 1; }
  100% { transform: scaleY(0.95) scaleX(1.05) rotate(-1deg); opacity: 0.9; }
}

.candle-wax {
  width: 14px;
  height: var(--candle-h);
  background: linear-gradient(180deg, #E8E4F0 0%, #B8B2C8 100%);
  border-radius: 2px 2px 4px 4px;
  position: relative;
  box-shadow: inset -2px 0 4px rgba(0, 0, 0, 0.2), 0 0 20px rgba(201, 169, 110, 0.15);
  transition: height 0.3s ease, opacity 0.6s ease;
}

.candle-wax::before {
  content: '';
  position: absolute;
  top: 0; left: -2px; right: -2px;
  height: 4px;
  background: #D4CFE0;
  border-radius: 50%;
}

.candle-base {
  width: 24px; height: 4px;
  background: linear-gradient(180deg, #4A3F6B 0%, #1A1728 100%);
  border-radius: 2px;
  margin-top: 2px;
}

.candle-smoke {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 4px; height: 4px;
  background: rgba(155, 148, 168, 0.5);
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
}

.reading-candle.extinguished .candle-flame {
  opacity: 0;
  transform: scaleY(0.2) scaleX(0.5);
}

.reading-candle.extinguished .candle-smoke {
  animation: smoke-rise 3s ease-out forwards;
}

@keyframes smoke-rise {
  0% { opacity: 0.6; transform: translateX(-50%) translateY(0) scale(1); }
  50% { opacity: 0.3; transform: translateX(-50%) translateY(-40px) scale(2.5); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-80px) scale(4); }
}

/* ============== 幽灵 ============== */
.ghost-companion {
  position: fixed;
  top: 0; left: 0;
  width: 36px; height: 44px;
  pointer-events: none;
  z-index: 9000;
  opacity: 0;
  transition: opacity 0.6s ease;
  filter: drop-shadow(0 0 14px rgba(139, 26, 74, 0.5));
  will-change: transform;
}

.ghost-companion.active { opacity: 1; }

.ghost-companion svg {
  width: 100%; height: 100%;
  animation: ghost-float 3s ease-in-out infinite;
}

@keyframes ghost-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-6px) rotate(2deg); }
}

.ghost-companion.startled {
  animation: ghost-startle 0.4s ease-out;
}

@keyframes ghost-startle {
  0% { transform: scale(1); }
  40% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* ============== 血月按钮 ============== */
.theme-toggle {
  position: fixed;
  right: 24px; bottom: 24px;
  width: 46px; height: 46px;
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  z-index: 9001;
  transition: all 0.4s var(--ease-soft);
}

.theme-toggle:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
  transform: translateY(-4px) rotate(15deg);
}

.theme-icon-bloodmoon { display: none; }
body[data-theme="bloodmoon"] .theme-icon-moon { display: none; }
body[data-theme="bloodmoon"] .theme-icon-bloodmoon { display: inline; }

/* ============== 返回顶部 ============== */
#back-to-top {
  position: fixed;
  left: 24px; bottom: 24px;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: rgba(26, 23, 40, 0.92);
  border: 1px solid var(--border);
  color: var(--accent-gold);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s var(--ease-soft);
  z-index: 9000;
}

#back-to-top.visible { opacity: 1; pointer-events: auto; }

#back-to-top:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
  transform: translateY(-4px);
}

/* ============== 响应式 ============== */
