<script is:inline>
(function initLoader() {
  const loader = document.getElementById('loader');
  if (!loader) return;

  let finished = false;

  function finishLoad() {
    if (finished) return;
    finished = true;
    loader.classList.add('hidden');
    setTimeout(() => loader.remove(), 1000);
  }

  function hideAfterFirstPaint() {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        setTimeout(finishLoad, 80);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hideAfterFirstPaint, { once: true });
  } else {
    hideAfterFirstPaint();
  }

  window.addEventListener('load', () => setTimeout(finishLoad, 80), { once: true });
  setTimeout(finishLoad, 1600);
})();

