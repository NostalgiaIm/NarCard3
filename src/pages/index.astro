   ============================================ */
(function initCodeTools() {
  function rule(src, cls) { return { re: new RegExp(src, 'y'), cls: cls }; }

  const NUM = '\\b\\d+(?:\\.\\d+)?\\b';
  const S = {
    sq: "'(?:[^'\\\\\\n]|\\\\.)*'",
    dq: '"(?:[^"\\\\\\n]|\\\\.)*"',
    tpl: '`(?:[^`\\\\]|\\\\.)*`',
    jsLine: '\\/\\/[^\\n]*',
    jsBlock: '\\/\\*[\\s\\S]*?\\*\\/',
    cssComment: '\\/\\*[\\s\\S]*?\\*\\/',
    htmlComment: '<!--[\\s\\S]*?-->',
    hash: '#[^\\n]*',
  };

  const KW = {
    bash: 'cd|ls|mkdir|touch|cp|mv|rm|rmdir|pwd|echo|cat|grep|apt|sudo|man|chmod|chown|export|source|exit|return|if|then|else|fi|for|do|done',
    css: 'media|import|keyframes|supports|root|to|from|and|not|only',
    ts: 'const|let|var|function|return|if|else|for|while|import|export|from|default|class|extends|new|await|async|type|interface|as|of|in|typeof|instanceof|null|undefined|true|false|this',
    html: '',
    json: 'true|false|null',
  };

  const THEMES = {
    bash: [
      rule(S.hash, 'tok-cm'),
      rule(S.dq, 'tok-str'), rule(S.sq, 'tok-str'),
      rule('\\b(?:' + KW.bash + ')\\b', 'tok-kw'),
      rule('-{1,2}[A-Za-z][\\w-]*', 'tok-fn'),
      rule(NUM, 'tok-num'),
    ],
    css: [
      rule(S.cssComment, 'tok-cm'),
      rule(S.dq, 'tok-str'), rule(S.sq, 'tok-str'),
      rule('@[\\w-]+', 'tok-kw'),
      rule('#[0-9a-fA-F]{3,8}\\b', 'tok-num'),
      rule('[-a-zA-Z]+(?=\\s*:)', 'tok-fn'),
      rule(NUM, 'tok-num'),
    ],
    typescript: [
      rule(S.jsLine, 'tok-cm'), rule(S.jsBlock, 'tok-cm'),
      rule(S.tpl, 'tok-str'), rule(S.dq, 'tok-str'), rule(S.sq, 'tok-str'),
      rule('\\b(?:' + KW.ts + ')\\b', 'tok-kw'),
      rule('[A-Za-z_$][\\w$]*(?=\\s*\\()', 'tok-fn'),
      rule(NUM, 'tok-num'),
    ],
    astro: [
      rule(S.htmlComment, 'tok-cm'),
      rule(S.jsLine, 'tok-cm'),
      rule(S.dq, 'tok-str'), rule(S.sq, 'tok-str'),
      rule('</?[A-Za-z][\\w-]*', 'tok-kw'),
      rule('\\b(?:' + KW.ts + ')\\b', 'tok-kw'),
      rule(NUM, 'tok-num'),
    ],
    html: [
      rule(S.htmlComment, 'tok-cm'),
      rule(S.dq, 'tok-str'), rule(S.sq, 'tok-str'),
      rule('</?[A-Za-z][\\w-]*', 'tok-kw'),
      rule('[A-Za-z-]+(?==)', 'tok-fn'),
    ],
    json: [
      rule(S.dq, 'tok-str'),
      rule('\\b(?:' + KW.json + ')\\b', 'tok-kw'),
      rule(NUM, 'tok-num'),
    ],
  };
  THEMES.javascript = THEMES.typescript;

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function highlight(raw, lang) {
    const rules = THEMES[String(lang || '').toLowerCase().trim()];
    if (!rules || !rules.length) return escapeHtml(raw);

    let out = '';
    let i = 0;
    while (i < raw.length) {
      let hit = null;
      for (let r = 0; r < rules.length; r++) {
        rules[r].re.lastIndex = i;
        const m = rules[r].re.exec(raw);
        if (m && m.index === i && m[0].length) { hit = { text: m[0], cls: rules[r].cls }; break; }
      }
      if (hit) {
        out += '<span class="' + hit.cls + '">' + escapeHtml(hit.text) + '</span>';
        i += hit.text.length;
      } else {
        // 连续的无匹配片段一次性输出，避免逐字符拼接
        let j = i + 1;
        while (j < raw.length) {
          let start = false;
          for (let r = 0; r < rules.length; r++) {
            rules[r].re.lastIndex = j;
            const m = rules[r].re.exec(raw);
            if (m && m.index === j && m[0].length) { start = true; break; }
          }
          if (start) break;
          j++;
        }
        out += escapeHtml(raw.slice(i, j));
        i = j;
      }
    }
    return out;
  }

  function paint(block, lang) {
    const codeEl = block.querySelector('code');
    if (!codeEl) return;
    const raw = codeEl.getAttribute('data-raw');
    if (raw === null) return;
    codeEl.innerHTML = highlight(raw, lang);
  }

  function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function (resolve, reject) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        resolve();
      } catch (err) { reject(err); }
    });
  }

  function enhance(root) {
    if (!root) return;
    const blocks = root.querySelectorAll('.code-block');
    Array.prototype.forEach.call(blocks, function (block) {
      if (block.getAttribute('data-ready') === '1') return;
      block.setAttribute('data-ready', '1');

      const codeEl = block.querySelector('code');
      const langEl = block.querySelector('.code-lang');
      const copyBtn = block.querySelector('.code-copy');
      if (!codeEl) return;

      // 保存原始文本，之后切换语言时反复高亮都基于它
      if (codeEl.getAttribute('data-raw') === null) {
        codeEl.setAttribute('data-raw', codeEl.textContent || '');
      }
      paint(block, block.getAttribute('data-lang'));

      // 复制
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          const text = codeEl.getAttribute('data-raw') || '';
          copyText(text).then(function () {
            copyBtn.textContent = '已复制';
            copyBtn.classList.add('copied');
            setTimeout(function () {
              copyBtn.textContent = '复制';
              copyBtn.classList.remove('copied');
            }, 1400);
          }).catch(function () {
            copyBtn.textContent = '复制失败';
            setTimeout(function () { copyBtn.textContent = '复制'; }, 1400);
          });
        });
      }

      // 语言标签可编辑：改完重新着色（不同语言不同主题）
      if (langEl) {
        const apply = function () {
          const lang = (langEl.textContent || '').trim().toLowerCase();
          block.setAttribute('data-lang', lang);
          paint(block, lang);
        };
        langEl.addEventListener('blur', apply);
        langEl.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); langEl.blur(); }
        });
      }
    });
  }

  window.__nocturneEnhanceCode = enhance;
})();

/* ============================================
   LaTeX 公式渲染（KaTeX）＋ 失败降级卡片
   ============================================ */
(function initMathTools() {
  let katexPromise = null;

  function whenKatex() {
    if (window.katex && typeof window.katex.render === 'function') {
      return Promise.resolve(window.katex);
    }
    if (!katexPromise) {
      katexPromise = new Promise(function (resolve) {
        let tries = 0;
        const timer = setInterval(function () {
          tries++;
          if (window.katex && typeof window.katex.render === 'function') {
            clearInterval(timer);
            resolve(window.katex);
          } else if (tries > 120) {
            clearInterval(timer);
            resolve(null);
          }
        }, 60);
      });
    }
    return katexPromise;
  }

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // 渲染不了就退成卡片，展示 LaTeX 源码
  function toCard(el, tex, reason) {
    el.classList.remove('tex-ok');
    el.classList.add('tex-fallback');
    el.innerHTML =
      '<div class="tex-card-head">'
      + '<span class="tex-badge">LaTeX</span>'
      + '<span class="tex-err">' + esc(reason || '未渲染') + '</span>'
      + '</div>'
      + '<div class="tex-card-body"><pre>' + esc(tex) + '</pre></div>'
      + '<div class="tex-card-foot">公式暂时无法渲染，已按源码显示。</div>';
  }

  function renderMath(root) {
    if (!root) return;
    const nodes = root.querySelectorAll('.tex');
    if (!nodes.length) return;

    whenKatex().then(function (katex) {
      Array.prototype.forEach.call(nodes, function (el) {
        const tex = el.getAttribute('data-tex') || '';
        const display = el.getAttribute('data-display') === '1';
        if (!tex.trim()) { el.textContent = ''; return; }
        if (!katex) { toCard(el, tex, 'KaTeX 未加载'); return; }
        try {
          katex.render(tex, el, {
            displayMode: display,
            throwOnError: true,
            strict: false,
            trust: false,
            output: 'html'
          });
          el.classList.add('tex-ok');
          el.classList.remove('tex-fallback');
        } catch (err) {
          toCard(el, tex, (err && err.message) ? String(err.message).slice(0, 120) : '语法错误');
        }
      });
    });
  }

  window.__nocturneRenderMath = renderMath;
})();

/* ============================================
   视图路由 + 幕布过渡
   ============================================ */
(function initViewRouter() {
  const curtain = document.getElementById('curtainTransition');
  const mark = document.getElementById('curtainMark');
  const indicator = document.getElementById('sectionIndicator');

  const DATA = (function () {
    const el = document.getElementById('nocturneData');
    try {
      return el ? JSON.parse(el.textContent) : { posts: [], tags: [] };
    } catch (err) {
      return { posts: [], tags: [] };
    }
  })();

  const VIEW_LABELS = {
    home: 'Home', archive: 'Archive', tags: 'Tags', gallery: 'Gallery',
    about: 'About', search: 'Search', article: 'Article', 'tag-detail': 'Tag',
  };

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // 有封面才渲染封面；没有封面的文章保持原样
  function coverMarkup(post) {
    if (!post.cover) return '';
    const pos = post.coverPosition || 'center';
    const alt = post.coverAlt || post.title;
    return '<figure class="article-cover" data-pos="' + escapeHtml(pos) + '">' +
      '<img src="' + escapeHtml(post.cover) + '" alt="' + escapeHtml(alt) + '" loading="lazy" />' +
      (post.coverAlt ? '<figcaption>' + escapeHtml(post.coverAlt) + '</figcaption>' : '') +
    '</figure>';
  }

  function renderArticle(slug) {
    const post = DATA.posts.filter(function (p) { return p.slug === slug; })[0];
    if (!post) return false;
    const titleEl = document.getElementById('articleTitle');
    const metaEl = document.getElementById('articleMeta');
    const tagsEl = document.getElementById('articleTags');
    const bodyEl = document.getElementById('articleBody');
    if (titleEl) titleEl.textContent = post.title;
    if (metaEl) metaEl.textContent = post.display + ' · ' + post.readTime + ' min read · ' + post.category;
    if (tagsEl) {
      tagsEl.innerHTML = post.tags.map(function (t) {
        return '<a class="article-tag" href="#tag-detail/' + encodeURIComponent(t) + '" data-view-link="tag-detail" data-param="' + escapeHtml(t) + '">' + escapeHtml(t) + '</a>';
      }).join('');
    }
    if (bodyEl) {
      bodyEl.innerHTML = coverMarkup(post) + post.body;
      if (window.__nocturneEnhanceCode) window.__nocturneEnhanceCode(bodyEl);
      if (window.__nocturneRenderMath) window.__nocturneRenderMath(bodyEl);
    }
    document.title = post.title + ' — Example Journal';
    return true;
  }

  function renderTagDetail(tag) {
    const items = DATA.posts.filter(function (p) { return p.tags.indexOf(tag) !== -1; });
    const nameEl = document.getElementById('tagDetailName');
    const metaEl = document.getElementById('tagDetailMeta');
    const listEl = document.getElementById('tagDetailList');
    if (nameEl) nameEl.textContent = tag;
    if (metaEl) metaEl.textContent = items.length + (items.length === 1 ? ' entry' : ' entries') + ' under this word';
    if (listEl) {
      listEl.innerHTML = items.map(function (p) {
        return '<li class="post-item">' +
          '<div class="post-item-meta"><span>' + escapeHtml(p.display) + '</span><span>' + escapeHtml(p.category) + '</span><span>' + p.readTime + ' min read</span></div>' +
          '<h2 class="post-item-title" data-view-link="article" data-param="' + escapeHtml(p.slug) + '">' + escapeHtml(p.title) + '</h2>' +
          '<p class="post-item-excerpt">' + escapeHtml(p.excerpt) + '</p>' +
          '<div class="post-item-tags">' + p.tags.map(function (t) {
            return '<span data-view-link="tag-detail" data-param="' + escapeHtml(t) + '">' + escapeHtml(t) + '</span>';
          }).join('') + '</div>' +
        '</li>';
      }).join('');
    }
    return true;
  }

  function parseHash() {
    const raw = decodeURIComponent(window.location.hash.replace(/^#/, ''));
    if (!raw) return { view: 'home', param: '' };
    const idx = raw.indexOf('/');
    const view = idx === -1 ? raw : raw.slice(0, idx);
    const param = idx === -1 ? '' : raw.slice(idx + 1);
    if (!document.querySelector('.view[data-view="' + view + '"]')) return { view: 'home', param: '' };
    return { view: view, param: param };
  }

  function applyView(view, param) {
    if (view === 'article' && !renderArticle(param)) return false;
    if (view === 'tag-detail' && !renderTagDetail(param)) return false;
    document.querySelectorAll('.view').forEach(function (v) {
      v.hidden = v.dataset.view !== view;
    });
    return true;
  }

  const initial = parseHash();
  let currentView = initial.view;
  let currentParam = initial.param;
  let lastRoute = { view: 'archive', param: '' };
  let routeStack = [{ view: currentView, param: currentParam }];
  let routeIndex = 0;
  let isTransitioning = false;
  let historyJumping = false;
  let historyJumpTimer = null;
  let transitionTimers = [];

  function hashFor(view, param) {
    if (view === 'home') return window.location.pathname;
    return '#' + view + (param ? '/' + encodeURIComponent(param) : '');
  }

  // 判断两个视图路由是否相同，避免重复写入浏览器历史。
  function sameRoute(left, right) {
    return left.view === right.view && left.param === right.param;
  }

  // 将当前站内路由栈保存在 History state 中，供 popstate 恢复。
  function saveRouteHistory(method, route) {
    const state = {
      ...(history.state || {}),
      __nocturneRouteHistory: true,
      routes: routeStack,
      index: routeIndex,
    };
    const url = hashFor(route.view, route.param);
    history[method](state, '', url);
  }

  // 将新导航压入站内历史，并丢弃已前进分支。
  function pushRoute(route) {
    const current = routeStack[routeIndex];
    if (current && sameRoute(current, route)) return;
    routeStack = routeStack.slice(0, routeIndex + 1);
    routeStack.push(route);
    routeIndex = routeStack.length - 1;
    saveRouteHistory('pushState', route);
  }

  // 清理幕布动画，避免浏览器前进/后退时旧定时器覆盖目标路由。
  function cancelTransition() {
    transitionTimers.forEach(function (timer) { clearTimeout(timer); });
    transitionTimers = [];
    if (curtain) curtain.classList.remove('active');
    if (mark) mark.classList.remove('visible');
    isTransitioning = false;
  }

  function switchView(view, param, updateHistory) {
    if (updateHistory === undefined) updateHistory = true;
    if (!applyView(view, param)) {
      view = 'home';
      param = '';
      applyView('home', '');
    }
    window.scrollTo({ top: 0, behavior: 'auto' });
    currentView = view;
    currentParam = param;

    if (updateHistory) {
      const route = { view: view, param: param };
      lastRoute = routeStack[routeIndex] || lastRoute;
      pushRoute(route);
    }

    if (indicator) {
      indicator.textContent = VIEW_LABELS[view] || 'Home';
      if (view === 'home') indicator.classList.remove('visible');
    }
  }

  function transitionTo(view, param) {
    if (!view) return;
    if (param === undefined) param = '';
    if (isTransitioning) return;
    if (view === currentView && param === currentParam) return;
    isTransitioning = true;
    const route = { view: view, param: param };

    // 1. 幕布合拢
    curtain.classList.add('active');

    // 2. 幕布合拢完成 → 切换视图 + 显示中央标记
    transitionTimers.push(setTimeout(function () {
      lastRoute = { view: currentView, param: currentParam };
      switchView(route.view, route.param, true);
      mark.classList.add('visible');
    }, 520));

    // 3. 标记开始淡出 + 幕布开始散开
    transitionTimers.push(setTimeout(function () {
      mark.classList.remove('visible');
      curtain.classList.remove('active');
    }, 820));

    // 4. 动画结束
    transitionTimers.push(setTimeout(function () {
      isTransitioning = false;
      transitionTimers = [];
    }, 1500));
  }

  // 在站内路由历史边界内移动，不调用浏览器站点之外的历史记录。
  function moveRouteHistory(direction) {
    const nextIndex = routeIndex + direction;
    if (isTransitioning || historyJumping || nextIndex < 0 || nextIndex >= routeStack.length) return false;
    historyJumping = true;
    history.go(direction);
    historyJumpTimer = setTimeout(function () {
      historyJumping = false;
    }, 700);
    return true;
  }

  // 暴露给其它脚本（搜索引擎、快捷键）
  window.__nocturneGo = transitionTo;
  window.__nocturneData = DATA;

  // 事件委托：所有 [data-view-link]（含动态生成的搜索结果、标签、文章标题）
  // 使用捕获阶段，避免组件内部 stopPropagation 导致路由收不到点击
  document.addEventListener('click', function (event) {
    const target = event.target;
    const el = target && target.closest ? target.closest('[data-view-link]') : null;
    if (!el) return;
    const view = el.getAttribute('data-view-link');
    if (!view) return;
    event.preventDefault();
    transitionTo(view, el.getAttribute('data-param') || '');
  }, true);

  // 初始化当前页面的站内历史状态，后续右键手势只在这个栈内移动。
  saveRouteHistory('replaceState', { view: currentView, param: currentParam });

  // 文章详情：返回上一级
  const backBtn = document.getElementById('articleBack');
  if (backBtn) {
    backBtn.addEventListener('click', function () {
      if (!moveRouteHistory(-1)) {
        transitionTo(lastRoute.view || 'archive', lastRoute.param || '');
      }
    });
  }

  // 画廊作品也可点进文章详情
  const galleryItems = document.querySelectorAll('.gallery-item');
  Array.prototype.forEach.call(galleryItems, function (item, index) {
    const post = DATA.posts[index % DATA.posts.length];
    if (!post) return;
    item.setAttribute('data-view-link', 'article');
    item.setAttribute('data-param', post.slug);
    item.setAttribute('role', 'link');
    item.setAttribute('tabindex', '0');
    item.classList.add('is-clickable');
  });

  // 浏览器历史前进/后退时，只恢复路由，不重新压入历史栈。
  window.addEventListener('popstate', function (event) {
    const state = event.state;
    if (state && state.__nocturneRouteHistory && state.routes && state.routes[state.index]) {
      cancelTransition();
      routeStack = state.routes;
      routeIndex = state.index;
      const route = routeStack[routeIndex];
      switchView(route.view, route.param, false);
      if (historyJumpTimer) clearTimeout(historyJumpTimer);
      historyJumping = false;
    }
  });

  window.addEventListener('hashchange', function () {
    if (history.state && history.state.__nocturneRouteHistory) return;
    const next = parseHash();
    if (next.view !== currentView || next.param !== currentParam) {
      cancelTransition();
      routeStack = [{ view: currentView, param: currentParam }, next];
      routeIndex = 1;
      saveRouteHistory('replaceState', next);
      switchView(next.view, next.param, false);
    }
  });

  /* ================= 右键横向导航手势 ================= */

  let gesture = null;
  let suppressContextMenu = false;
  let suppressContextMenuTimer = null;
  const GESTURE_ACTIVATE_DISTANCE = 14;
  const GESTURE_TRIGGER_DISTANCE = 96;

  // 判断右键手势是否从可安全接管的页面空白区域开始。
  function isGestureExcludedTarget(target) {
    const element = target && target.closest ? target.closest('input, textarea, select, button, a, code, pre, [contenteditable="true"], [role="textbox"], [data-view-link]') : null;
    return Boolean(element);
  }

  // 清理右键手势状态并恢复页面文本选择。
  function clearGesture() {
    if (document.documentElement.style.userSelect === 'none') {
      document.documentElement.style.userSelect = '';
    }
    gesture = null;
  }

  // 记录鼠标右键按下位置，暂不阻止原生右键菜单。
  document.addEventListener('pointerdown', function (event) {
    if (event.pointerType !== 'mouse' || event.button !== 2 || event.ctrlKey || event.shiftKey || event.altKey || event.metaKey) return;
    if (isGestureExcludedTarget(event.target) || isTransitioning || historyJumping) return;
    gesture = {
      pointerId: event.pointerId,
      startX: event.clientX,
      startY: event.clientY,
      active: false,
      handled: false,
    };
  }, true);

  // 只有达到激活距离后才阻止默认拖拽和文本选择。
  document.addEventListener('pointermove', function (event) {
    if (!gesture || event.pointerId !== gesture.pointerId || (event.buttons & 2) === 0) return;
    const dx = event.clientX - gesture.startX;
    const dy = event.clientY - gesture.startY;
    if (!gesture.active && Math.abs(dx) >= GESTURE_ACTIVATE_DISTANCE && Math.abs(dx) > Math.abs(dy) * 1.25) {
      gesture.active = true;
      document.documentElement.style.userSelect = 'none';
    }
    if (gesture.active) event.preventDefault();
  }, true);

  // 右键横向滑动达到阈值后，移动站内路由历史。
  document.addEventListener('pointerup', function (event) {
    if (!gesture || event.pointerId !== gesture.pointerId) return clearGesture();
    const dx = event.clientX - gesture.startX;
    const dy = event.clientY - gesture.startY;
    if (gesture.active && !gesture.handled && Math.abs(dx) >= GESTURE_TRIGGER_DISTANCE && Math.abs(dx) > Math.abs(dy) * 1.25) {
      gesture.handled = true;
      suppressContextMenu = true;
      moveRouteHistory(dx < 0 ? -1 : 1);
      event.preventDefault();
    }
    clearGesture();
  }, true);

  // 有效手势期间屏蔽右键菜单；普通短按右键仍保留浏览器菜单。
  document.addEventListener('contextmenu', function (event) {
    if (gesture && gesture.active || suppressContextMenu) {
      event.preventDefault();
      event.stopPropagation();
      suppressContextMenu = false;
      if (suppressContextMenuTimer) clearTimeout(suppressContextMenuTimer);
      suppressContextMenuTimer = null;
    }
  }, true);

  window.addEventListener('pointercancel', clearGesture, true);
  window.addEventListener('blur', clearGesture);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) clearGesture();
  });

  // 首次进入/刷新时按 URL hash 恢复界面，例如 /#article/xxx、/#tag-detail/Gothic
  switchView(currentView, currentParam, false);
})();

/* ============================================
   粒子背景
   ============================================ */
(function initParticles() {
  const canvas = document.getElementById('particles-canvas');
  if (!canvas || !window.THREE) return;
  const cores = navigator.hardwareConcurrency || 2;
  const PARTICLE_COUNT = cores < 4 ? 1200 : 3500;

  // 按视锥分布：每个粒子在自身深度上铺满该深度的可视范围，
  // 避免近处粒子跑出屏幕、远处粒子挤向中心（中间密、两边空）。
  const CAMERA_Z = 30;
  const FOV = 70;
  const TAN_HALF_FOV = Math.tan((FOV * Math.PI) / 360);
  const DEPTH_NEAR = 10;
  const DEPTH_FAR = 50;
  const OVERSCAN = 1.18; // 超出视口 18%，保证四边始终有粒子

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(FOV, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = CAMERA_Z;
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(PARTICLE_COUNT * 3);
  const colors = new Float32Array(PARTICLE_COUNT * 3);
  const sizes = new Float32Array(PARTICLE_COUNT);
  const speeds = new Float32Array(PARTICLE_COUNT);
  const ndcX = new Float32Array(PARTICLE_COUNT);
  const worldY = new Float32Array(PARTICLE_COUNT);
  const depths = new Float32Array(PARTICLE_COUNT);
  const palette = [
    new THREE.Color('#4A3F6B'),
    new THREE.Color('#6B2D5C'),
    new THREE.Color('#8B1A4A'),
    new THREE.Color('#C9A96E'),
  ];

  function halfHeightAt(d) { return TAN_HALF_FOV * d; }
  function aspectNow() { return window.innerWidth / window.innerHeight; }

  function layout() {
    const aspect = aspectNow();
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const hh = halfHeightAt(depths[i]);
      positions[i * 3] = ndcX[i] * hh * aspect;
      positions[i * 3 + 1] = worldY[i];
      positions[i * 3 + 2] = CAMERA_Z - depths[i];
    }
    geometry.attributes.position.needsUpdate = true;
  }

  for (let i = 0; i < PARTICLE_COUNT; i++) {
    const d = DEPTH_NEAR + Math.random() * (DEPTH_FAR - DEPTH_NEAR);
    depths[i] = d;
    ndcX[i] = (Math.random() * 2 - 1) * OVERSCAN;
    worldY[i] = (Math.random() * 2 - 1) * halfHeightAt(d) * OVERSCAN;
    const color = palette[Math.floor(Math.random() * palette.length)];
    colors[i * 3] = color.r; colors[i * 3 + 1] = color.g; colors[i * 3 + 2] = color.b;
    sizes[i] = Math.random() * 1.4 + 0.3;
    speeds[i] = Math.random() * 0.008 + 0.003;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geometry.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
  const material = new THREE.ShaderMaterial({
    transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    vertexShader: `
      attribute float size;
      attribute vec3 color;
      varying vec3 vColor;
      void main() {
        vColor = color;
        vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = size * (300.0 / -mvPosition.z);
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      void main() {
        float d = distance(gl_PointCoord, vec2(0.5));
        if (d > 0.5) discard;
        float alpha = (1.0 - d * 2.0) * 0.55;
        gl_FragColor = vec4(vColor, alpha);
      }
    `
  });
  const points = new THREE.Points(geometry, material);
  scene.add(points);
  let running = true, time = 0;
  function animate() {
    if (!running) return;
    requestAnimationFrame(animate);
    time += 0.001;
    const aspect = aspectNow();
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const hh = halfHeightAt(depths[i]);

      // 上浮：世界速度恒定，近处看起来更快，保留纵深视差
      worldY[i] += speeds[i];

      // 越界后从底部回卷，并换一列，避免长期集中在同一区域
      if (worldY[i] / hh > OVERSCAN) {
        worldY[i] = -hh * OVERSCAN;
        ndcX[i] = (Math.random() * 2 - 1) * OVERSCAN;
      }

      // 轻微横向摆动，并限制在视口外扩范围内，防止漂出边缘
      ndcX[i] += Math.sin(time + i) * 0.0001;
      if (ndcX[i] > OVERSCAN) ndcX[i] = -OVERSCAN;
      else if (ndcX[i] < -OVERSCAN) ndcX[i] = OVERSCAN;

      positions[i * 3] = ndcX[i] * hh * aspect;
      positions[i * 3 + 1] = worldY[i];
      positions[i * 3 + 2] = CAMERA_Z - depths[i];
    }
    geometry.attributes.position.needsUpdate = true;
    renderer.render(scene, camera);
  }
  layout();
  animate();
  document.addEventListener('visibilitychange', () => {
    running = !document.hidden;
    if (running) animate();
  });
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      layout();
    }, 150);
  });
})();

/* ============================================
   鼠标粒子轨迹
   ============================================ */
(function initCursorTrail() {
  const canvas = document.getElementById('cursor-trail');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let w, h, dpr;
  function resize() {
    dpr = Math.min(window.devicePixelRatio, 2);
    w = window.innerWidth; h = window.innerHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  const palette = [
    { r: 139, g: 26, b: 74 },
    { r: 201, g: 169, b: 110 },
    { r: 74, g: 63, b: 107 },
    { r: 176, g: 42, b: 90 },
  ];
  const sprites = palette.map(c => {
    const size = 64;
    const off = document.createElement('canvas');
    off.width = off.height = size;
    const g = off.getContext('2d');
    const grad = g.createRadialGradient(size/2, size/2, 0, size/2, size/2, size/2);
    grad.addColorStop(0, `rgba(${c.r},${c.g},${c.b},1)`);
    grad.addColorStop(0.35, `rgba(${c.r},${c.g},${c.b},0.55)`);
    grad.addColorStop(1, `rgba(${c.r},${c.g},${c.b},0)`);
    g.fillStyle = grad;
    g.fillRect(0, 0, size, size);
    return off;
  });
  const particles = [];
  const MAX = 90;
  let mouseX = 0, mouseY = 0, lastX = 0, lastY = 0, trailX = 0, trailY = 0;
  let hasMoved = false, isInside = true;
  function spawn(x, y, speed) {
    if (particles.length >= MAX) return;
    const idx = Math.floor(Math.random() * palette.length);
    const size = Math.random() * 2.5 + 1.2;
    const life = Math.random() * 45 + 35;
    const angle = Math.random() * Math.PI * 2;
    const spread = Math.random() * 0.6;
    particles.push({
      x, y,
      vx: Math.cos(angle) * spread + (Math.random() - 0.5) * speed * 0.4,
      vy: Math.sin(angle) * spread - Math.random() * 0.4,
      size, initialSize: size, life, maxLife: life, sprite: sprites[idx],
    });
  }
  function handleMove(x, y) {
    const dx = x - lastX, dy = y - lastY;
    const dist = Math.sqrt(dx * dx + dy * dy);
    mouseX = x; mouseY = y;
    const count = Math.min(Math.floor(dist / 5) + 1, 4);
    for (let i = 0; i < count; i++) {
      const t = count > 1 ? i / (count - 1) : 0;
      spawn(lastX + dx * t, lastY + dy * t, dist);
    }
    lastX = x; lastY = y; hasMoved = true;
  }
  window.addEventListener('mousemove', (e) => {
    if (!hasMoved) {
      lastX = e.clientX; lastY = e.clientY;
      trailX = e.clientX; trailY = e.clientY;
    }
    handleMove(e.clientX, e.clientY);
  }, { passive: true });
  window.addEventListener('mouseleave', () => { isInside = false; });
  window.addEventListener('mouseenter', () => { isInside = true; hasMoved = false; });
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;
  let running = true, frame = 0;
  function animate() {
    if (!running) return;
    requestAnimationFrame(animate);
    frame++;
    ctx.clearRect(0, 0, w, h);
    trailX += (mouseX - trailX) * 0.28;
    trailY += (mouseY - trailY) * 0.28;
    if (hasMoved && isInside && frame % 3 === 0) spawn(trailX, trailY, 0.5);
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.vx *= 0.97; p.vy *= 0.97; p.vy -= 0.015;
      p.life--;
      if (p.life <= 0) { particles.splice(i, 1); continue; }
      const t = p.life / p.maxLife;
      const alpha = t * t;
      const size = p.initialSize * (0.4 + t * 0.6);
      const drawSize = size * 6;
      ctx.globalAlpha = alpha;
      ctx.drawImage(p.sprite, p.x - drawSize / 2, p.y - drawSize / 2, drawSize, drawSize);
      ctx.globalAlpha = alpha * 0.9;
      ctx.fillStyle = '#E8E4F0';
      ctx.beginPath();
      ctx.arc(p.x, p.y, size * 0.45, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }
  animate();
  document.addEventListener('visibilitychange', () => {
    running = !document.hidden;
    if (running) animate();
  });
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 150);
  });
})();

/* ============================================
   右上角板块指示 —— 滚动触发
   ============================================ */
(function initSectionIndicator() {
  const indicator = document.getElementById('sectionIndicator');
  if (!indicator) return;

  const threshold = 200;
  let ticking = false;

  function update() {
    // 首页滚动时不显示，其他视图滚动才显示
    const currentView = document.querySelector('.view:not([hidden])')?.dataset.view;
    indicator.classList.toggle('visible', window.scrollY > threshold && currentView !== 'home');
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }, { passive: true });

  // 视图切换后也检查一次
  window.__updateIndicator = update;
  update();
})();

/* ============================================
   侧边轨道
   ============================================ */
(function initSideOrbs() {
  const radius = window.innerWidth <= 1024 ? 78 : 90;
  const stepDelay = 50;
  document.querySelectorAll('.side-orb').forEach(orb => {
    const side = orb.dataset.side;
    const buttons = orb.querySelectorAll('.orb-btn');
    const total = buttons.length;
    buttons.forEach((btn, i) => {
      const t = total > 1 ? i / (total - 1) : 0.5;
      let angle = side === 'left' ? -60 + 120 * t : 240 - 120 * t;
      const rad = angle * Math.PI / 180;
      btn.style.setProperty('--tx', (radius * Math.cos(rad)).toFixed(2) + 'px');
      btn.style.setProperty('--ty', (radius * Math.sin(rad)).toFixed(2) + 'px');
      btn.style.setProperty('--delay', (i * stepDelay) + 'ms');
      btn.style.setProperty('--close-delay', ((total - 1 - i) * stepDelay) + 'ms');
    });
    const icon = orb.querySelector('.orb-icon');
    icon.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.side-orb.active').forEach(other => {
        if (other !== orb) other.classList.remove('active');
      });
      orb.classList.toggle('active');
    });
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // 注意：这里不能 stopPropagation，否则 document 上的视图路由收不到点击
        const label = btn.dataset.label;
        if (label === 'Top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          orb.classList.remove('active');
          return;
        }
        if (label === 'Theme') {
          document.getElementById('themeToggle')?.click();
          orb.classList.remove('active');
          return;
        }
        // 其他按钮如果是视图链接，等过渡结束后再关闭轨道
        setTimeout(() => orb.classList.remove('active'), 200);
      });
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.side-orb.active').forEach(orb => {
      if (!orb.contains(e.target)) orb.classList.remove('active');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.side-orb.active').forEach(orb => orb.classList.remove('active'));
    }
  });
})();

/* ============================================
   蜡烛
   ============================================ */
(function initReadingCandle() {
  const candle = document.getElementById('readingCandle');
  const wax = document.getElementById('candleWax');
  if (!candle || !wax) return;
  const MAX_HEIGHT = 140;
  let ticking = false;
  function update() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
    candle.classList.toggle('active', scrollTop > 200);
    wax.style.height = MAX_HEIGHT * (1 - progress) + 'px';
    candle.classList.toggle('extinguished', progress >= 0.98);
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();

/* ============================================
   幽灵
   ============================================ */
(function initGhostCompanion() {
  const ghost = document.getElementById('ghostCompanion');
  if (!ghost) return;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (isMobile || prefersReduced) return;
  let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
  let ghostX = mouseX, ghostY = mouseY;
  let hasMoved = false;
  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX; mouseY = e.clientY;
    if (!hasMoved) {
      ghostX = mouseX; ghostY = mouseY;
      hasMoved = true;
      ghost.classList.add('active');
    }
  }, { passive: true });
  window.addEventListener('click', () => {
    ghost.classList.remove('startled');
    void ghost.offsetWidth;
    ghost.classList.add('startled');
    setTimeout(() => ghost.classList.remove('startled'), 400);
  });
  function animate() {
    ghostX += (mouseX - ghostX) * 0.06;
    ghostY += (mouseY - ghostY) * 0.06;
    ghost.style.transform = `translate(${ghostX + 20}px, ${ghostY + 32}px)`;
    requestAnimationFrame(animate);
  }
  animate();
})();

/* ============================================
   血月
   ============================================ */
(function initThemeToggle() {
  const btn = document.getElementById('themeToggle');
  if (!btn) return;
  const root = document.documentElement;
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  function applyTheme(theme) {
    const bloodmoon = theme === 'bloodmoon';
    if (bloodmoon) {
      document.body.setAttribute('data-theme', 'bloodmoon');
      root.setAttribute('data-theme', 'bloodmoon');
      if (themeMeta) themeMeta.setAttribute('content', '#1A0A0A');
    } else {
      document.body.removeAttribute('data-theme');
      root.removeAttribute('data-theme');
      if (themeMeta) themeMeta.setAttribute('content', '#0D0B1A');
    }
  }
  applyTheme(localStorage.getItem('nocturne-theme') === 'bloodmoon' ? 'bloodmoon' : 'default');
  btn.addEventListener('click', () => {
    const next = document.body.getAttribute('data-theme') === 'bloodmoon' ? 'default' : 'bloodmoon';
    localStorage.setItem('nocturne-theme', next);
    applyTheme(next);
  });
})();

/* ============================================
   滚动进度条
   ============================================ */
(function initScrollProgress() {
  const bar = document.getElementById('scroll-progress');
  let ticking = false;
  function update() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (docHeight > 0 ? (scrollTop / docHeight) * 100 : 0) + '%';
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();

/* ============================================
   返回顶部
   ============================================ */
(function initBackToTop() {
  const btn = document.getElementById('back-to-top');
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        btn.classList.toggle('visible', window.scrollY > 600);
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
  btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
})();

/* ============================================
   Tags 页字体切换（G 哥特体 / C 易读体）
   ============================================ */
(function initTagFontToggle() {
  const view = document.getElementById('tagsView');
  const btn = document.getElementById('tagFontToggle');
  if (!view || !btn) return;

  const KEY = 'nocturne-tag-font';

  function apply(readable) {
    view.classList.toggle('readable', readable);
    btn.classList.toggle('readable', readable);
    btn.textContent = readable ? 'C' : 'G';
    btn.setAttribute('aria-pressed', readable ? 'true' : 'false');
    btn.setAttribute('aria-label', readable
      ? '当前为易读字体，点击切回哥特体'
      : '当前为哥特字体，点击切换为易读字体');
  }

  // 记住上次选择
  let saved = false;
  try { saved = localStorage.getItem(KEY) === 'readable'; } catch (err) { /* 忽略 */ }
  apply(saved);

  btn.addEventListener('click', function () {
    const next = !view.classList.contains('readable');
    apply(next);
    try { localStorage.setItem(KEY, next ? 'readable' : 'gothic'); } catch (err) { /* 忽略 */ }
  });
})();

/* ============================================
   搜索（数据来自站内文章）
   ============================================ */
(function initSearch() {
  const input = document.getElementById('searchInput');
  if (!input) return;
  const hint = document.getElementById('searchHint');
  const resultsList = document.getElementById('searchResults');
  const meta = document.getElementById('searchMeta');
  const count = document.getElementById('searchCount');
  const empty = document.getElementById('searchEmpty');

  const data = (window.__nocturneData && window.__nocturneData.posts) || [];

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c]);
  }

  function highlight(text, query) {
    if (!query) return escapeHtml(text);
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp('(' + escaped + ')', 'gi');
    return escapeHtml(text).replace(re, '<mark>$1</mark>');
  }

  function render(query) {
    const q = query.trim().toLowerCase();

    const filtered = !q ? data : data.filter(item => {
      const hay = (item.title + ' ' + item.excerpt + ' ' + item.category + ' ' + item.tags.join(' ')).toLowerCase();
      return hay.indexOf(q) !== -1;
    });

    if (meta) meta.textContent = !q ? 'All entries' : 'Results for "' + query.trim() + '"';
    if (count) count.textContent = String(filtered.length);

    if (!resultsList) return;

    if (filtered.length === 0) {
      resultsList.innerHTML = '';
      if (empty) empty.hidden = false;
      return;
    }

    if (empty) empty.hidden = true;
    resultsList.innerHTML = filtered.map(item => (
      '<li class="search-result" data-view-link="article" data-param="' + escapeHtml(item.slug) + '">' +
        '<div class="search-result-meta">' +
          '<span class="search-result-date">' + escapeHtml(item.display) + '</span>' +
          '<span class="search-result-tags">' + item.tags.map(t => escapeHtml(t)).join(' · ') + '</span>' +
        '</div>' +
        '<h3 class="search-result-title">' + highlight(item.title, q) + '</h3>' +
        '<p class="search-result-excerpt">' + highlight(item.excerpt, q) + '</p>' +
      '</li>'
    )).join('');
  }

  input.addEventListener('input', () => render(input.value));
  input.addEventListener('focus', () => { if (hint) hint.classList.add('active'); });
  input.addEventListener('blur', () => { if (hint) hint.classList.remove('active'); });
  render('');

  // 按 / 跳转到搜索视图并聚焦
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) {
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      e.preventDefault();
      if (window.__nocturneGo) {
        window.__nocturneGo('search', '');
        setTimeout(() => input.focus(), 620);
      }
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input.blur();
    }
  });
})();
</script>
