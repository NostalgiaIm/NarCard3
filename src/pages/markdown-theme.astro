          <td>Long-form reading</td>
        </tr>
        <tr>
          <td>Mono / Code</td>
          <td>JetBrains Mono</td>
          <td>Code blocks, tokens</td>
        </tr>
      </tbody>
    </table>

    <hr>

    <!-- 图片 -->
    <h2>Image</h2>

    <p>图片有细边框和极小圆角，下方可以配斜体题注：</p>

    <figure>
      <img src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 400'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%231A1728'/%3E%3Cstop offset='1' stop-color='%238B1A4A'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='800' height='400' fill='url(%23g)'/%3E%3Ctext x='400' y='200' font-family='serif' font-size='48' fill='%23C9A96E' text-anchor='middle' dominant-baseline='middle'%3EExample Journal%3C/text%3E%3C/svg%3E" alt="示例图片">
