---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About this Astro journal template.">
  <main class="template-about">
    <h1>About this template</h1>
    <p>Example Journal is a dark, gothic-inspired Astro template for notes, essays, documentation, and design experiments.</p>
    <p>Replace this page with your own project description, author information, and links.</p>
  </main>
</BaseLayout>
<style>
  .template-about { width: min(760px, calc(100% - 40px)); margin: 0 auto; padding: 7rem 0; color: #e8e2f2; line-height: 1.8; }
  .template-about h1 { color: #f5f1fb; }
</style>